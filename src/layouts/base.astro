---
import '@/styles/global.css'

import BottomNav from '@/components/sections/BottomNav.astro'
import Footer from '@/components/sections/Footer.astro'
import Header from '@/components/sections/Header.astro'
import { meta } from '@/lib/content'
import { SITE, absoluteUrl, pageTitle } from '@/lib/site'
import { text } from '@/lib/text'

type JsonLd = Record<string, unknown>

/**
 * Casca de toda página: cabeçalho fixo no topo, menu fixo na base (mobile), o conteúdo entre eles e
 * o rodapé do ecossistema (desktop). `dock`: a página tem régua fixa acima do menu do mobile (busca e
 * tags na capa, índice na página do projeto) e reserva o espaço dela.
 */
interface Props {
  title: string
  description: string
  path: string
  jsonLd?: JsonLd[]
  noindex?: boolean
  /** Cartão de compartilhamento próprio (caminho); sem ele, o do `meta.json`. */
  image?: string
  dock?: boolean
}

const { title, description, path, jsonLd = [], noindex = false, image, dock = false } = Astro.props
const url = absoluteUrl(path)
const card = image ? { url: absoluteUrl(image), width: 1200, height: 630, alt: title } : meta.image
/** Open Graph (web-social-share): `website` na capa, `article` nas demais. */
const ogType = path === '/' ? meta.open_graph.type : 'article'

const person = { '@type': 'Person', name: SITE.author, alternateName: SITE.brand, jobTitle: SITE.role, url: SITE.home, sameAs: meta.author.same_as }
const documents: JsonLd[] = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: meta.title, url: `${SITE.url}/`, inLanguage: SITE.lang, author: person }, ...jsonLd]
const analytics = SITE.analytics
/** Amplitude Analytics pelo CDN, com Session Replay (astro-amplitude › Script). */
const apiKey = import.meta.env.PUBLIC_AMPLITUDE_API_KEY
---

<!doctype html>
<html lang={SITE.lang} class="bg-surface-0 [color-scheme:dark] [scrollbar-color:var(--color-surface-3)_var(--color-surface-0)]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={noindex ? 'noindex, follow' : meta.robots} />
    <title>{pageTitle(title)}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="alternate" type="text/plain" href={absoluteUrl('/llms.txt')} title="llms.txt" />
    <link rel="canonical" href={url} />
    <link rel="icon" href="https://cdn.thiagoeti.dev/favicon.ico" sizes="250x250" />
    <link rel="icon" href="https://cdn.thiagoeti.dev/system/logo.svg" type="image/svg+xml" />
    <meta name="theme-color" content={meta.theme_color} />
    <meta name="keywords" content={meta.keywords.join(', ')} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={meta.open_graph.site_name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={card.url} />
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:image" content={card.url} />
    <meta name="twitter:image:alt" content={card.alt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    {documents.map((doc) => <script type="application/ld+json" set:html={JSON.stringify(doc)} />)}

    <!-- Volta da página do projeto: o nome dele na lista recebe a transição antes do primeiro quadro. -->
    <script is:inline>
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return
        const nav = globalThis.navigation
        const from = nav && nav.activation && nav.activation.from && nav.activation.from.url
        const slug = from ? new URL(from).pathname.split('/')[1] : ''
        const el = slug && document.querySelector('li[data-project="' + CSS.escape(slug) + '"] [data-title]')
        if (el) el.classList.add('[view-transition-name:project]')
      })
    </script>

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics}`}></script>
    <script>
      import meta from '../../.content/meta.json'

      const w = window as Window & { dataLayer?: unknown[] }
      const layer = (w.dataLayer ??= [])
      function gtag(..._args: unknown[]) {
        layer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', meta.analytics.google)
    </script>

    <script is:inline src={`https://cdn.amplitude.com/script/${apiKey}.js`}></script>
    <script is:inline define:vars={{ apiKey }}>
      window.amplitude.add(window.sessionReplay.plugin({ sampleRate: 0.1 }))
      window.amplitude.init(apiKey, {
        fetchRemoteConfig: true,
        autocapture: {
          attribution: true,
          fileDownloads: true,
          formInteractions: true,
          pageViews: true,
          sessions: true,
          elementInteractions: true,
          networkTracking: true,
          webVitals: true,
          frustrationInteractions: true,
        },
      })
    </script>
  </head>
  <body class="min-h-dvh
    font-sans antialiased bg-surface-0 text-fg
    selection:bg-brand/30 selection:text-fg group/page">
    <a
      href="#conteudo"
      class="px-4 py-2
        sr-only
        text-xs font-semibold uppercase tracking-wider bg-brand text-surface-0 rounded-control
        focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      {text.skip}
    </a>
    <div class="h-[36rem]
      absolute inset-x-0 top-0 z-0
      bg-[radial-gradient(ellipse_at_top_left,rgb(45_212_168/0.08),transparent_45%)]
      pointer-events-none" aria-hidden="true"></div>
    <Header path={path} />
    <main
      id="conteudo"
      class:list={[
        'pt-16 relative lg:pb-0',
        dock ? 'pb-[calc(10rem+env(safe-area-inset-bottom))]' : 'pb-[calc(4rem+env(safe-area-inset-bottom))]',
      ]}
    >
      <slot />
    </main>
    <Footer />
    <slot name="dock" />
    <BottomNav path={path} />
  </body>
</html>
