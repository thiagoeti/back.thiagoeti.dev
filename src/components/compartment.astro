---
/**
 * Compartimento do chassi aberto: uma parte da página do projeto, com a serigrafia da placa no
 * canto — designador (`J3`) e nome. A ordem é a do chassi, da frente para a traseira; o mapa do
 * chassi (`chassis-map.astro`) aponta para cada um pelo `id`.
 */
interface Props {
	id: string
	code: string
	title: string
}

const { id, code, title } = Astro.props
---

<section id={id} aria-labelledby={`h-${id}`} class="scroll-mt-20 border-t border-line px-4 py-6 first:border-t-0 lg:px-8 lg:py-8" data-compartment>
	<header class="mb-5 flex items-baseline gap-3">
		<span class="rounded-[2px] border border-line-strong px-1 font-mono text-[11px] leading-snug tabular-nums text-fg-subtle">{code}</span>
		<h2 id={`h-${id}`} class="text-lg font-semibold text-fg">{title}</h2>
	</header>
	<div class="flex flex-col gap-6">
		<slot />
	</div>
</section>
