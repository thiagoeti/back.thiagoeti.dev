---
import Icon from './icon.astro'
import { projects, tags } from '../lib/projects'
import { focusRing, motion } from '../lib/site'
import { text } from '../lib/text'

/**
 * Barra de comando (THEME.md › Search / Command Bar) com as tags (`/?tag=`): busca por nome,
 * tecnologia ou tag (`/` foca, `Esc` limpa) e as tags da que mais projetos tem para a que menos tem.
 * `dock`: régua fixa acima do menu inferior, na zona do polegar (DESIGN.md).
 */
interface Props {
	dock?: boolean
}

const { dock = false } = Astro.props
const s = text.search
const t = text.filter
const chip = `flex min-h-10 shrink-0 items-center gap-2 rounded-badge border border-line px-2.5 text-xs whitespace-nowrap text-fg-muted hover:border-line-strong hover:text-fg aria-pressed:border-brand/30 aria-pressed:bg-brand/5 aria-pressed:text-fg lg:min-h-8 ${motion} ${focusRing}`
---

<div
	class:list={[
		dock
			? 'fixed inset-x-0 bottom-[calc(4rem+env(safe-area-inset-bottom))] z-30 flex flex-col gap-2 border-t border-line bg-surface-0/95 px-4 py-2 backdrop-blur lg:hidden'
			: 'hidden flex-col gap-3 lg:flex',
	]}
	role="search"
	aria-label={t.label}
>
	<label class="flex h-10 w-full items-center gap-2 rounded-control border border-line bg-surface-1 px-3 text-sm text-fg focus-within:border-line-strong focus-within:ring-2 focus-within:ring-brand/40 lg:h-9 lg:max-w-sm">
		<Icon name="search" class="size-4 text-fg-subtle" />
		<span class="sr-only">{s.label}</span>
		<input type="search" data-search placeholder={s.placeholder} autocomplete="off" spellcheck="false" class="min-w-0 flex-1 bg-transparent outline-none placeholder:text-fg-subtle [&::-webkit-search-cancel-button]:hidden" />
		<kbd class="hidden rounded-badge border border-line bg-surface-3 px-1.5 py-0.5 font-mono text-[10px] text-fg-subtle lg:inline">{s.shortcut}</kbd>
	</label>
	<div class:list={['flex items-center gap-2', dock ? 'overflow-x-auto overscroll-x-contain [scrollbar-width:none]' : 'flex-wrap']}>
		<button type="button" class={chip} data-tag="" aria-pressed="true">
			{t.all}
			<span class="font-mono tabular-nums text-fg-subtle">{projects.length}</span>
		</button>
		{
			tags.map((x) => (
				<button type="button" class={chip} data-tag={x.name} aria-pressed="false">
					#{x.name}
					<span class="font-mono tabular-nums text-fg-subtle">{x.count}</span>
				</button>
			))
		}
	</div>
</div>
