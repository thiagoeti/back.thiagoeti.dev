---
import Icon from './icon.astro'
import { techIconOf } from '../lib/icons'
import { techMark, type Tone } from '../lib/techglyph'

/**
 * Ícone da tecnologia no chip de stack: o logo oficial do catálogo (`tech-*`, Simple Icons) quando existe;
 * senão o satélite do vocabulário do glifo (techglyph.ts), em `currentColor`. Decorativo: o nome vem ao lado.
 */
interface Props {
	name: string
	class?: string
}

const { name, class: className = 'size-3.5' } = Astro.props
const logo = techIconOf(name)
const TONE: Partial<Record<Tone, string>> = {
	sat: 'fill-none stroke-current stroke-[1.6]',
	satFill: 'fill-current',
}
const mark = logo ? [] : techMark(name)
---

{
	logo ? (
		<Icon name={logo} class={className} />
	) : (
		<svg viewBox="-11 -11 22 22" class:list={['shrink-0', className]} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			{mark.map((e) => (e.tag === 'circle' ? <circle {...e.a} class={TONE[e.tone]} /> : <path {...e.a} class={TONE[e.tone]} />))}
		</svg>
	)
}
