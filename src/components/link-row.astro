---
import Icon from './icon.astro'
import { linkHref, linkText, type Link } from '../lib/content'
import { iconOf } from '../lib/icons'
import { SITE, detent, focusRing } from '../lib/site'

/** Linha de link do ecossistema ou contato: ícone de utilidade, nome, papel e endereço. Externo abre em nova aba. */
interface Props {
	item: Link
}

const { item } = Astro.props
const href = linkHref(item)
const here = !!item.link && new URL(item.link).host === SITE.host
const external = /^https?:/.test(href) && !here
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener' : undefined}
	aria-current={here ? 'page' : undefined}
	class={`group flex min-h-11 items-center gap-3 rounded-control px-2 py-1.5 hover:bg-white/[0.03] aria-[current=page]:text-brand ${detent} ${focusRing}`}
>
	<span class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-fg-subtle group-hover:border-brand/40 group-hover:text-brand group-aria-[current=page]:border-brand/40 group-aria-[current=page]:text-brand">
		<Icon name={iconOf(item.icon)} class="size-4" />
	</span>
	<span class="min-w-0 flex-1">
		<span class="flex items-baseline gap-2">
			<span class="text-xs font-semibold text-fg group-aria-[current=page]:text-brand">{item.label}</span>
			{item.type && <span class="truncate text-[11px] text-fg-subtle">{item.type}</span>}
		</span>
		<span class="block truncate text-[11px] text-fg-subtle">{linkText(item)}</span>
	</span>
</a>
