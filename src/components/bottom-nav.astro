---
import { HEIGHT } from '../lib/rack'
import { NAV, focusRing, isCurrent, motion } from '../lib/site'
import { fill, text } from '../lib/text'

/** Menu inferior (tablet pra baixo, DESIGN.md): os mesmos itens do topo, na mesma ordem, ao alcance do polegar. */
interface Props {
	path: string
}

const { path } = Astro.props
---

<nav aria-label={text.nav.label} class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface-sunken pb-[env(safe-area-inset-bottom)] lg:hidden">
	<ul class="grid h-16 auto-cols-fr grid-flow-col">
		{
			NAV.map((n) => (
				<li class="min-w-0">
					<a
						href={n.href}
						aria-current={isCurrent(n, path) ? 'page' : undefined}
						class={`group relative flex h-full flex-col items-center justify-center gap-1 px-0.5 text-[11px] leading-none text-fg-subtle hover:text-fg aria-[current=page]:text-fg before:absolute before:inset-x-3 before:top-0 before:h-0.5 before:bg-transparent aria-[current=page]:before:bg-brand ${motion} ${focusRing}`}
					>
						<span class="font-mono text-sm tabular-nums text-fg-faint group-aria-[current=page]:text-brand">{n.project ? n.project.serial : fill(text.home.units, { n: HEIGHT })}</span>
						<span class="max-w-full truncate">{n.project ? n.project.short : text.nav.home}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
