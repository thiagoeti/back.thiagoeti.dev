---
import Icon from './icon.astro'
import { NAV, isCurrent } from '../lib/site'
import { text } from '../lib/text'

/**
 * Menu inferior (tablet pra baixo, DESIGN.md), no padrão dos sites do ecossistema: os mesmos itens do topo,
 * na mesma ordem, ao alcance do polegar; ícone (Todos) ou ponto de estado (projeto) sobre o rótulo e, de `md` pra cima, à esquerda dele.
 */
interface Props {
	path: string
}

const { path } = Astro.props
---

<nav aria-label={text.nav.label} class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface-sunken/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md lg:hidden print:hidden">
	<ul class="grid h-16 auto-cols-fr grid-flow-col">
		{
			NAV.map((n) => (
				<li class="min-w-0">
					<a
						href={n.href}
						aria-current={isCurrent(n, path) ? 'page' : undefined}
						class:list={[
							'group focus-ring relative flex h-full flex-col items-center justify-center gap-1 px-0.5 text-[10px] font-medium text-fg-subtle transition-colors duration-150 hover:text-fg motion-reduce:transition-none aria-[current=page]:text-brand 2xs:text-[11px] md:flex-row md:gap-2 md:text-xs',
							'before:absolute before:inset-x-3 before:top-0 before:h-0.5 before:rounded-full before:bg-transparent aria-[current=page]:before:bg-brand md:before:inset-x-5',
						]}
					>
						{n.project ? (
							<span class="grid size-5 place-items-center" aria-hidden="true">
								<span class:list={['size-2 rounded-full', n.project.github.docker ? 'bg-brand' : 'bg-info']} />
							</span>
						) : (
							<Icon name="layout-grid" class="size-5" />
						)}
						<span class="max-w-full truncate">{n.project ? n.project.short : text.nav.home}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
