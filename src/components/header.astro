---
import Icon from './icon.astro'
import LinkRow from './link-row.astro'
import { contacts, ecosystem, intro, titles } from '../lib/content'
import { HEIGHT } from '../lib/rack'
import { NAV, SITE, focusRing, isCurrent, motion } from '../lib/site'
import { fill, text } from '../lib/text'

/**
 * Cabeçalho fixo (LAYOUT.md) — o topo do rack: logo e título à esquerda; o título é o caminho até
 * aqui, `@thiagoeti / back-end / servidor 03`. Desktop: o menu são as etiquetas do rack (número e
 * nome curto de cada servidor), com a altura do rack ao lado. Tablet pra baixo: o mesmo menu desce
 * para a base (bottom-nav.astro) e o botão Rede abre o ecossistema e os contatos, que saem da página.
 */
interface Props {
	path: string
}

const { path } = Astro.props
const here = NAV.find((n) => n.project && isCurrent(n, path))?.project
const item = `group relative flex h-16 items-center gap-2 px-3 text-sm whitespace-nowrap text-fg-muted hover:text-fg aria-[current=page]:text-fg before:absolute before:inset-x-3 before:bottom-0 before:h-0.5 before:bg-transparent aria-[current=page]:before:bg-brand ${motion} ${focusRing}`
---

<header class="fixed inset-x-0 top-0 z-40 h-16 border-b border-line bg-surface-0">
	<div class="mx-auto flex h-full w-full max-w-[90rem] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
		<div class="flex min-w-0 items-center gap-3 text-sm">
			<a href="/" aria-label={text.brand.home} class={`grid size-10 shrink-0 place-items-center rounded-control border border-line hover:border-line-strong ${motion} ${focusRing}`}>
				<img src="https://cdn.thiagoeti.dev/system/logo.svg" alt="" width="20" height="20" class="size-5" />
			</a>
			<p class="flex min-w-0 items-center gap-1.5 leading-none">
				<a href={SITE.home} target="_blank" rel="noopener" class={`hidden text-fg-subtle hover:text-fg xs:inline ${focusRing}`}>{SITE.brand}</a>
				<span class="hidden text-fg-faint xs:inline" aria-hidden="true">/</span>
				<a href="/" class={`font-semibold text-fg lowercase hover:text-brand ${focusRing}`}>{intro.title}</a>
				{
					here && (
						<>
							<span class="text-fg-faint" aria-hidden="true">/</span>
							<span class="truncate text-fg-muted">{fill(text.nav.unit, { n: here.serial })}</span>
						</>
					)
				}
			</p>
		</div>

		<nav aria-label={text.nav.label} class="hidden lg:block">
			<ul class="flex items-center">
				{
					NAV.map((n) => (
						<li>
							<a href={n.href} aria-current={isCurrent(n, path) ? 'page' : undefined} class={item}>
								{n.project ? (
									<>
										<span class="font-mono text-xs tabular-nums text-fg-faint group-aria-[current=page]:text-brand">{n.project.serial}</span>
										{n.project.short}
									</>
								) : (
									<>
										<span class="font-mono text-xs tabular-nums text-fg-faint group-aria-[current=page]:text-brand">{fill(text.home.units, { n: HEIGHT })}</span>
										{text.nav.home}
									</>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button
			type="button"
			popovertarget="rede"
			class={`flex h-10 shrink-0 items-center gap-2 rounded-control border border-line px-3 text-sm text-fg-muted hover:border-line-strong hover:text-fg lg:hidden ${motion} ${focusRing}`}
		>
			<Icon name="globe" class="size-4" />
			{text.network.open}
		</button>
	</div>
</header>

<div
	id="rede"
	popover
	aria-label={text.network.label}
	class="inset-x-0 top-16 bottom-auto m-0 max-h-[calc(100dvh-4rem)] w-full overflow-y-auto border-b border-line bg-surface-1 p-4 text-fg backdrop:bg-surface-sunken/70 lg:hidden"
>
	<div class="flex items-center justify-between gap-4 pb-2">
		<h2 class="plate text-fg-muted">{titles.ecosystem}</h2>
		<button type="button" popovertarget="rede" popovertargetaction="hide" class={`flex h-10 items-center rounded-control border border-line px-3 text-sm text-fg-muted hover:text-fg ${focusRing}`}>
			{text.network.close}
		</button>
	</div>
	<ul class="grid gap-0.5 sm:grid-cols-2">
		{ecosystem.map((l) => <li><LinkRow item={l} /></li>)}
	</ul>
	<h2 class="plate mt-4 pb-2 text-fg-muted">{titles.contacts}</h2>
	<ul class="grid gap-0.5 sm:grid-cols-2">
		{contacts.map((l) => <li><LinkRow item={l} /></li>)}
	</ul>
</div>
