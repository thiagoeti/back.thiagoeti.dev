---
import Shapes from './shapes.astro'
import type { Shape } from '../lib/glyphs'

/**
 * Glifo autônomo (emblema de projeto ou tag). `live` acende o acento; `draw` desenha o traço ao entrar.
 * `vault` dá o nome da view transition: o emblema clicado no mostrador vira este.
 */
interface Props {
	shapes: Shape[]
	size: number
	class?: string
	label?: string
	live?: boolean
	draw?: boolean
	vault?: boolean
}

const { shapes, size, class: className = 'size-8', label, live = false, draw = false, vault = false } = Astro.props
---

<svg
	viewBox={`0 0 ${size} ${size}`}
	class:list={['group/glyph shrink-0 overflow-visible', vault && '[view-transition-name:vault]', className]}
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	data-live={live ? '' : undefined}
	data-draw={draw ? '' : undefined}
>
	<Shapes shapes={shapes} />
</svg>
