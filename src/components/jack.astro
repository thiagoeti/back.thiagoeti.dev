---
/**
 * Porta RJ45 vista de frente: boca com o entalhe da trava embaixo, oito contatos no alto e o LED de
 * link no canto. Acende (`data-on` no ancestral `group/jack`) quando o cabo da tag está ligado.
 */
interface Props {
	class?: string
}

const { class: className = 'h-4 w-5' } = Astro.props
---

<svg viewBox="0 0 20 16" class:list={['shrink-0 overflow-visible', className]} stroke-width="1.25" stroke-linejoin="round" aria-hidden="true">
	<path
		d="M1.5 1.5h17v10h-5v3h-7v-3h-5z"
		class="fill-surface-sunken stroke-fg-faint transition-colors duration-300 group-hover/jack:stroke-fg-muted group-data-[on]/jack:stroke-brand motion-reduce:transition-none"
		vector-effect="non-scaling-stroke"
	></path>
	<path d="M5 4v2.5M7 4v2.5M9 4v2.5M11 4v2.5M13 4v2.5M15 4v2.5" class="fill-none stroke-fg-faint group-data-[on]/jack:stroke-brand/70" vector-effect="non-scaling-stroke"></path>
	<rect x="15.5" y="12.5" width="3" height="2" rx="0.5" class="fill-fg-faint stroke-none transition-colors duration-300 group-data-[on]/jack:fill-brand motion-reduce:transition-none"></rect>
</svg>
