---
/**
 * Prancha: uma tela do eixo horizontal da página do projeto. Número grande apagado, título da seção
 * do README e o conteúdo; rola na vertical só por dentro quando não cabe.
 */
interface Props {
	id: string
	n: number
	title: string
	wide?: boolean
}

const { id, n, title, wide = false } = Astro.props
---

<section
	id={id}
	data-plate={id}
	aria-labelledby={`${id}-titulo`}
	class:list={[
		'relative flex h-full w-full outline-none shrink-0 [&>*]:shrink-0 snap-start flex-col gap-6 overflow-y-auto overscroll-contain border-r border-line-subtle px-4 py-6 [scrollbar-width:thin] sm:px-8 lg:px-10 lg:py-8',
		wide ? 'lg:w-[min(72rem,92vw)]' : 'lg:w-[34rem] xl:w-[38rem]',
	]}
>
	<header class="flex items-baseline gap-4">
		<span class="text-5xl leading-none font-normal tabular-nums text-fg-faint/60 lg:text-6xl" aria-hidden="true">{String(n).padStart(2, '0')}</span>
		<h2 id={`${id}-titulo`} class="eyebrow">{title}</h2>
	</header>
	<slot />
</section>
