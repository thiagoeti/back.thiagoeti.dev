---
/**
 * Score Ring (THEME.md › Score Ring): `value` de `max`, o número no centro e um rótulo curto embaixo.
 * Traço `brand` com tudo presente, `warning` com falta; `neutral` usa `info`.
 */
interface Props {
	value: number
	max: number
	label: string
	size?: 'md' | 'lg'
	/** Rótulo visível embaixo do número; sem ele, o rótulo fica só para o leitor de tela. */
	caption?: boolean
	/** Proporção sem julgamento (não é falta): traço `info`. */
	neutral?: boolean
}

const { value, max, label, size = 'md', caption = true, neutral = false } = Astro.props
const R = 24
const C = 2 * Math.PI * R
const ratio = max ? Math.min(1, value / max) : 0
const full = value >= max
---

<div class:list={['relative grid shrink-0 place-items-center', size === 'lg' ? 'size-20' : 'size-14']} role="img" aria-label={`${value} / ${max} ${label}`}>
	<svg viewBox="0 0 56 56" class="absolute inset-0 size-full -rotate-90" aria-hidden="true">
		<circle cx="28" cy="28" r={R} class="fill-none stroke-surface-3 stroke-[4]" />
		<circle
			cx="28"
			cy="28"
			r={R}
			stroke-dasharray={`${(C * ratio).toFixed(2)} ${C.toFixed(2)}`}
			class:list={['fill-none stroke-[4] [stroke-linecap:round]', neutral ? 'stroke-info' : full ? 'stroke-brand' : 'stroke-warning']}
		/>
	</svg>
	<span class="flex flex-col items-center leading-none">
		<span class:list={['font-medium tabular-nums text-fg', size === 'lg' ? 'text-2xl' : 'text-lg']}>{value}</span>
		{caption && <span class:list={['mt-0.5 text-[10px] uppercase tracking-wider', full ? 'text-brand' : 'text-warning']}>{label}</span>}
	</span>
</div>
