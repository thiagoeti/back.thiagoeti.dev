---
import { meta } from '../lib/content'
import { text } from '../lib/text'

/**
 * Régua de tomadas (2U): uma tomada por palavra-chave do `meta.json`, com a etiqueta ao lado —
 * o que alimenta a busca pelo rack.
 */
---

<section aria-label={text.home.pdu} class="flex h-full flex-col gap-2 rounded-[3px] border border-line-strong bg-surface-sunken p-3 lg:flex-row lg:items-center lg:gap-6 lg:px-4 lg:py-2">
	<p class="plate shrink-0 lg:w-28">{text.home.pdu}</p>
	<ul class="flex flex-wrap gap-x-4 gap-y-2">
		{
			meta.keywords.map((w) => (
				<li class="flex items-center gap-2">
					<span class="relative grid h-5 w-4 shrink-0 place-items-center rounded-[3px] border border-fg-faint bg-surface-1" aria-hidden="true">
						<span class="absolute top-1 left-[3px] h-1.5 w-px bg-fg-subtle" />
						<span class="absolute top-1 right-[3px] h-1.5 w-px bg-fg-subtle" />
						<span class="absolute bottom-1 size-[3px] rounded-full bg-fg-subtle" />
					</span>
					<span class="text-xs whitespace-nowrap text-fg-muted">{w}</span>
				</li>
			))
		}
	</ul>
</section>
