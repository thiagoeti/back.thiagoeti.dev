---
import Shapes from '@/components/ui/Shapes.astro'
import { inline } from '@/lib/markdown'
import { INLINE_CODE, focusRing } from '@/lib/site'
import { text } from '@/lib/text'
import type { Scene } from '@/lib/tracks'

/**
 * Diagrama do README como topologia (THEME.md › Chart Container, referência "Infrastructure Health
 * Map"): o desenho de `src/lib/tracks.ts` sobre o fundo pontilhado; embaixo, os nós como lista de nós
 * e as mensagens ou ligações como log numerado. A fonte mermaid fica num `details`.
 */
interface Props {
  title: string
  scene: Scene
  source: string
}

const { title, scene, source } = Astro.props
const t = text.project
const TONE = { label: 'tabular-nums fill-fg-subtle', text: 'fill-fg-subtle', key: 'font-medium fill-fg', dark: 'font-medium fill-surface-0' } as const
const nodes = scene.legend.filter((l) => l.kind === 'node')
const rest = scene.legend.filter((l) => l.kind !== 'node')
---

<section id="diagrama" aria-labelledby="diagrama-titulo" class="scroll-mt-32 p-6 flex flex-col bg-surface-1 rounded-card border border-line">
  <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div class="flex flex-col gap-1">
      <h2 id="diagrama-titulo" class="heading-panel">{title}</h2>
      <p class="body-sm">{nodes.length} {scene.kind === 'sequence' ? t.participants : t.nodes}{rest.length > 0 && `, ${rest.filter((r) => r.kind === 'message').length} ${scene.kind === 'sequence' ? t.messages : t.edges}`}</p>
    </div>
    <ul class="flex items-center gap-4 text-xs text-fg-muted" aria-hidden="true">
      <li class="inline-flex items-center gap-2"><span class="h-px w-4 bg-brand/60" />{scene.kind === 'sequence' ? t.messages : t.edges}</li>
      {scene.kind === 'sequence' && <li class="inline-flex items-center gap-2"><span class="w-4 border-t border-dashed border-info/60" />{t.output}</li>}
    </ul>
  </header>

  <div class="p-4 overflow-x-auto dot-grid rounded-control border border-line-subtle">
    <svg viewBox={`0 0 ${scene.width} ${scene.height}`} class="h-auto w-full min-w-[32rem] block font-mono" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={nodes.map((n) => n.label).join(', ')}>
      <Shapes shapes={scene.shapes} />
      {
        scene.labels.map((l) => (
          <text x={l.x} y={l.y} font-size={l.size} text-anchor={l.anchor ?? 'middle'} class={TONE[l.tone]}>
            {l.text}
          </text>
        ))
      }
    </svg>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
    <div class="flex flex-col gap-2">
      <p class="mb-1 eyebrow">{scene.kind === 'sequence' ? t.participants : t.nodes}</p>
      <ul class="flex flex-col gap-1.5">
        {
          nodes.map((n) => (
            <li class="px-3 py-2.5
              flex items-center justify-between gap-3
              bg-surface-2/60 rounded-control border border-line-subtle">
              <span class="min-w-0 flex items-center gap-2.5">
                <span class="size-2 shrink-0 bg-brand rounded-full" aria-hidden="true" />
                <span class="text-sm font-medium text-fg">{n.label}</span>
              </span>
              <span class="shrink-0 mono-status text-fg-subtle">{n.id}</span>
            </li>
          ))
        }
      </ul>
    </div>
    {
      rest.length > 0 && (
        <div class="flex flex-col gap-2">
          <p class="mb-1 eyebrow">{scene.kind === 'sequence' ? t.messages : t.edges}</p>
          <ol class="flex flex-col divide-y divide-line-subtle">
            {rest.map((m) =>
              m.kind === 'block' ? (
                <li class="px-3 pt-3 pb-1 font-mono text-[11px] uppercase text-fg-subtle">{m.label}</li>
              ) : (
                <li class="px-3 py-2.5 grid grid-cols-[1.75rem_auto_minmax(0,1fr)] items-baseline gap-3">
                  <span class="font-mono text-xs tabular-nums text-fg-faint">{String(m.n ?? '').padStart(2, '0')}</span>
                  <span class:list={['font-mono text-xs whitespace-nowrap', m.dashed ? 'text-info' : 'text-brand']}>
                    {m.from} {m.dashed ? '⇠' : '→'} {m.to}
                  </span>
                  <span class={`text-sm text-fg-muted ${INLINE_CODE}`} set:html={inline(m.label)} />
                </li>
              ),
            )}
          </ol>
        </div>
      )
    }
  </div>

  <details class="mt-6 bg-surface-sunken rounded-control border border-line">
    <summary class={`min-h-11 px-4
      flex items-center
      font-mono text-xs text-fg-subtle
      cursor-pointer
      hover:text-fg
      ${focusRing}`}>{t.mermaid}</summary>
    <pre class="px-4 py-3
      overflow-x-auto
      font-mono text-xs leading-relaxed text-fg-muted border-t border-line">{source}</pre>
  </details>
</section>
