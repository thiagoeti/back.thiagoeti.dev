---
import { f } from '@/lib/grid'
import { text } from '@/lib/text'

/**
 * Abertura (.analyse/design.md › Revisão 10): um back-end em funcionamento, desenhado em glifos de
 * sistema — clientes, entrada, serviços, fila, cache, workers e banco de dados — com dados passando
 * sem parar pelos trilhos. Nenhuma linguagem nem tecnologia. Dois desenhos com os mesmos sistemas:
 * paisagem do tablet para cima, retrato no celular. Movimento em `src/scripts/systems.ts`; com
 * `prefers-reduced-motion` a cena fica parada.
 */
const t = text.systems
type Kind = 'browser' | 'mobile' | 'legacy' | 'gateway' | 'service' | 'queue' | 'cache' | 'worker' | 'database'
type Node = { id: string; kind: Kind; x: number; y: number; label?: string }
type Edge = { from: string; to: string; flow: 'sync' | 'async' | 'store' }
type View = { id: string; cls: string; w: number; h: number; s: number; nodes: Node[]; vertical: boolean }

const EDGES: Edge[] = [
  { from: 'browser', to: 'gateway', flow: 'sync' },
  { from: 'mobile', to: 'gateway', flow: 'sync' },
  { from: 'legacy', to: 'gateway', flow: 'sync' },
  { from: 'gateway', to: 'svc1', flow: 'sync' },
  { from: 'gateway', to: 'svc2', flow: 'sync' },
  { from: 'gateway', to: 'svc3', flow: 'sync' },
  { from: 'svc1', to: 'queue', flow: 'async' },
  { from: 'svc2', to: 'queue', flow: 'async' },
  { from: 'svc2', to: 'cache', flow: 'sync' },
  { from: 'svc3', to: 'cache', flow: 'sync' },
  { from: 'svc1', to: 'database', flow: 'store' },
  { from: 'svc3', to: 'database', flow: 'store' },
  { from: 'queue', to: 'worker', flow: 'async' },
  { from: 'worker', to: 'database', flow: 'store' },
]

const wide: View = {
  id: 'paisagem',
  /* cabe na tela junto com o título: a altura para no que sobra da janela; o desenho centraliza */
  cls: 'hidden md:max-h-[max(20rem,calc(100dvh-18rem))] md:block',
  w: 1200,
  h: 540,
  s: 1,
  vertical: false,
  nodes: [
    { id: 'browser', kind: 'browser', x: 92, y: 120, label: t.browser },
    { id: 'mobile', kind: 'mobile', x: 92, y: 270, label: t.mobile },
    { id: 'legacy', kind: 'legacy', x: 92, y: 420, label: t.legacy },
    { id: 'gateway', kind: 'gateway', x: 330, y: 270, label: t.gateway },
    { id: 'svc1', kind: 'service', x: 570, y: 130 },
    { id: 'svc2', kind: 'service', x: 570, y: 270, label: t.service },
    { id: 'svc3', kind: 'service', x: 570, y: 410 },
    { id: 'queue', kind: 'queue', x: 820, y: 110, label: t.queue },
    { id: 'cache', kind: 'cache', x: 820, y: 430, label: t.cache },
    { id: 'worker', kind: 'worker', x: 1060, y: 110, label: t.worker },
    { id: 'database', kind: 'database', x: 1060, y: 330, label: t.database },
  ],
}
const tall: View = {
  id: 'retrato',
  cls: 'md:hidden',
  w: 360,
  h: 800,
  s: 0.72,
  vertical: true,
  nodes: [
    { id: 'browser', kind: 'browser', x: 66, y: 84, label: t.browser },
    { id: 'mobile', kind: 'mobile', x: 180, y: 84, label: t.mobile },
    { id: 'legacy', kind: 'legacy', x: 294, y: 84, label: t.legacy },
    { id: 'gateway', kind: 'gateway', x: 180, y: 230, label: t.gateway },
    { id: 'svc1', kind: 'service', x: 66, y: 380 },
    { id: 'svc2', kind: 'service', x: 180, y: 380, label: t.service },
    { id: 'svc3', kind: 'service', x: 294, y: 380 },
    { id: 'queue', kind: 'queue', x: 96, y: 530, label: t.queue },
    { id: 'cache', kind: 'cache', x: 280, y: 530, label: t.cache },
    { id: 'worker', kind: 'worker', x: 96, y: 690, label: t.worker },
    { id: 'database', kind: 'database', x: 280, y: 690, label: t.database },
  ],
}

/** Meia altura ou meia largura do glifo, para o trilho começar na borda. */
const HALF: Record<Kind, { w: number; h: number }> = {
  browser: { w: 56, h: 38 },
  mobile: { w: 24, h: 40 },
  legacy: { w: 44, h: 38 },
  gateway: { w: 50, h: 50 },
  service: { w: 50, h: 34 },
  queue: { w: 64, h: 22 },
  cache: { w: 36, h: 30 },
  worker: { w: 36, h: 36 },
  database: { w: 42, h: 50 },
}

function rail(v: View, e: Edge): string {
  const a = v.nodes.find((n) => n.id === e.from)!
  const b = v.nodes.find((n) => n.id === e.to)!
  const ha = HALF[a.kind]
  const hb = HALF[b.kind]
  const k = v.s
  if (v.vertical || Math.abs(b.x - a.x) < 40) {
    const dir = Math.sign(b.y - a.y) || 1
    const p = { x: a.x, y: a.y + dir * ha.h * k }
    const q = { x: b.x, y: b.y - dir * hb.h * k }
    const m = (q.y - p.y) / 2
    return `M${f(p.x)} ${f(p.y)}C${f(p.x)} ${f(p.y + m)} ${f(q.x)} ${f(q.y - m)} ${f(q.x)} ${f(q.y)}`
  }
  const p = { x: a.x + ha.w * k, y: a.y }
  const q = { x: b.x - hb.w * k, y: b.y }
  const m = (q.x - p.x) / 2
  return `M${f(p.x)} ${f(p.y)}C${f(p.x + m)} ${f(p.y)} ${f(q.x - m)} ${f(q.y)} ${f(q.x)} ${f(q.y)}`
}

/** Engrenagem do worker: dentes em volta de um aro. */
const gear = (x: number, y: number, r: number, teeth = 10) =>
  Array.from({ length: teeth * 2 }, (_, i) => {
    const a = (i / (teeth * 2)) * Math.PI * 2
    const rr = i % 2 ? r : r + 5
    return `${i ? 'L' : 'M'}${f(x + Math.cos(a) * rr)} ${f(y + Math.sin(a) * rr)}`
  }).join('') + 'Z'
const hex = (x: number, y: number, r: number) =>
  Array.from({ length: 6 }, (_, i) => `${i ? 'L' : 'M'}${f(x + Math.cos(-Math.PI / 2 + (i * Math.PI) / 3) * r)} ${f(y + Math.sin(-Math.PI / 2 + (i * Math.PI) / 3) * r)}`).join('') + 'Z'
---

<figure class="relative overflow-hidden
  bg-surface-sunken rounded-panel border border-line shadow-panel" data-systems>
  <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
  <div class="absolute inset-0
    bg-[radial-gradient(ellipse_at_center,rgb(45_212_168/0.06),transparent_60%)]
    pointer-events-none" aria-hidden="true"></div>
  {
    [wide, tall].map((v) => (
      <svg viewBox={`0 0 ${v.w} ${v.h}`} class:list={['h-auto w-full relative font-mono', v.cls]} role="img" aria-label={t.label} stroke-linecap="round" stroke-linejoin="round" data-systems-view={v.id}>
        <g class="fill-none stroke-line-strong [stroke-dasharray:2_6]" stroke-width="1.2">
          {EDGES.map((e) => (
            <path d={rail(v, e)} data-rail data-from={e.from} data-to={e.to} data-flow={e.flow} />
          ))}
        </g>

        {v.nodes.map((n) => (
          <g class="group/sys" data-sys={n.id} transform={`translate(${n.x} ${n.y}) scale(${v.s})`}>
            <circle r="62" class="fill-brand/10 stroke-none opacity-0
              transition-opacity duration-300
              group-data-[pulse]/sys:opacity-100" />
            <g class="fill-none stroke-fg-muted" stroke-width="1.5">
              {n.kind === 'browser' && (
                <>
                  <rect x="-56" y="-38" width="112" height="76" rx="9" class="fill-surface-1" />
                  <path d="M-56 -20H56" />
                  <circle cx="-45" cy="-29" r="2.2" class="fill-fg-faint stroke-none" />
                  <circle cx="-37" cy="-29" r="2.2" class="fill-fg-faint stroke-none" />
                  <circle cx="-29" cy="-29" r="2.2" class="fill-brand stroke-none" />
                  <path d="M-42 -4H6M-42 8H26M-42 20H-8" class="stroke-fg-faint" />
                  <rect x="18" y="-8" width="26" height="18" rx="3" class="stroke-brand/60" />
                </>
              )}
              {n.kind === 'mobile' && (
                <>
                  <rect x="-24" y="-40" width="48" height="80" rx="10" class="fill-surface-1" />
                  <path d="M-7 -32H7" class="stroke-fg-faint" />
                  <path d="M-10 31H10" />
                  <rect x="-15" y="-20" width="30" height="13" rx="3" class="stroke-brand/60" />
                  <path d="M-15 1H15M-15 10H7" class="stroke-fg-faint" />
                </>
              )}
              {n.kind === 'legacy' && (
                <>
                  {[0, 1, 2].map((k) => (
                    <>
                      <rect x="-44" y={-38 + k * 26} width="88" height="22" rx="3" class="fill-surface-1" />
                      <path d={`M-34 ${-27 + k * 26}H4`} class="stroke-fg-faint [stroke-dasharray:3_3]" />
                      <circle cx="30" cy={-27 + k * 26} r="2.6" class:list={['stroke-none', k === 1 ? 'fill-warning' : 'fill-brand']} />
                    </>
                  ))}
                </>
              )}
              {n.kind === 'gateway' && (
                <>
                  <circle r="50" class="fill-surface-1 stroke-line-strong" />
                  {Array.from({ length: 36 }, (_, i) => {
                    const a = (i / 36) * Math.PI * 2
                    const r0 = i % 3 ? 45 : 40
                    return <path d={`M${f(Math.cos(a) * r0)} ${f(Math.sin(a) * r0)}L${f(Math.cos(a) * 50)} ${f(Math.sin(a) * 50)}`} class="stroke-fg-faint" />
                  })}
                  <path d={hex(0, 0, 28)} class="fill-surface-2 stroke-brand/60" />
                  <path d={hex(0, 0, 15)} class="stroke-brand" />
                  <circle r="4" class="fill-brand stroke-none" />
                </>
              )}
              {n.kind === 'service' && (
                <>
                  <rect x="-50" y="-34" width="100" height="68" rx="10" class="fill-surface-1" />
                  <path d="M-50 -14H50" class="stroke-line-strong" />
                  <circle cx="-38" cy="-24" r="3" class="fill-success stroke-none animate-pulse-dot motion-reduce:animate-none" />
                  <path d="M-28 -24H10" class="stroke-fg-faint" />
                  <path d="M-24 0l-10 9 10 9M24 0l10 9-10 9" class="stroke-brand" />
                  <path d="M6 -2L-6 20" class="stroke-fg-muted" />
                </>
              )}
              {n.kind === 'queue' && (
                <>
                  <rect x="-64" y="-22" width="128" height="44" rx="22" class="fill-surface-1" />
                  {[0, 1, 2, 3, 4].map((k) => (
                    <rect x={-48 + k * 20} y="-9" width="14" height="18" rx="3" class:list={[k < 3 ? 'fill-info/25 stroke-info' : 'stroke-fg-faint']} />
                  ))}
                  <path d="M54 -6l6 6-6 6" class="stroke-info" />
                </>
              )}
              {n.kind === 'cache' && (
                <>
                  <rect x="-30" y="-24" width="60" height="48" rx="6" class="fill-surface-1" />
                  {[-18, -6, 6, 18].map((d) => (
                    <path d={`M${d} -24V-31M${d} 24V31M-30 ${d * 0.8}H-37M30 ${d * 0.8}H37`} class="stroke-fg-faint" />
                  ))}
                  <path d="M4 -14L-8 3H1L-3 15L9 -2H0Z" class="fill-warning stroke-none" />
                </>
              )}
              {n.kind === 'worker' && (
                <>
                  <path d={gear(0, 0, 28)} class="fill-surface-1" />
                  <circle r="12" class="stroke-brand" />
                  <circle r="3.5" class="fill-brand stroke-none" />
                </>
              )}
              {n.kind === 'database' && (
                <>
                  <path d="M-42 -36a42 14 0 1 0 84 0a42 14 0 1 0-84 0V36a42 14 0 0 0 84 0V-36" class="fill-surface-1" />
                  <path d="M-42 -12a42 14 0 0 0 84 0M-42 12a42 14 0 0 0 84 0" class="stroke-line-strong" />
                  <circle cx="28" cy="2" r="2.6" class="fill-brand stroke-none" />
                  <circle cx="28" cy="26" r="2.6" class="fill-brand stroke-none" />
                </>
              )}
            </g>
            {/* no retrato os trilhos cruzam embaixo dos glifos: só os clientes levam rótulo, em cima */}
            {n.label && (!v.vertical || ['browser', 'mobile', 'legacy'].includes(n.kind)) && (
              <text y={v.vertical ? -HALF[n.kind].h - 14 : HALF[n.kind].h + 24} text-anchor="middle" font-size={v.vertical ? 15 : 11} class="uppercase fill-fg-subtle">
                {n.label}
              </text>
            )}
          </g>
        ))}
        <g data-particles />
      </svg>
    ))
  }
</figure>
