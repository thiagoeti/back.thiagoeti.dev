---
import type { Project } from '../lib/projects'
import { focusRing, motion } from '../lib/site'
import { text } from '../lib/text'

/**
 * Mapa do chassi: o servidor visto de cima, frente no alto e traseira embaixo. Na frente, uma baia
 * por arquivo; no meio, um chip por cpu e um pente por 256 MB de memória (`docker.sh`); na traseira,
 * a porta exposta. Entre eles, um compartimento por parte da página, na ordem — o compartimento à
 * vista acende (`src/scripts/chassis.ts`). No mobile o mapa vira a fileira de compartimentos no alto.
 */
interface Props {
	project: Project
	parts: { id: string; code: string; title: string }[]
}

const { project: p, parts } = Astro.props
const mb = (m: string) => {
	const n = parseFloat(m)
	return /g/i.test(m) ? n * 1024 : n
}
const cpus = Math.max(0, Math.round(Number(p.docker.cpus) || 0))
const dimms = p.docker.memory ? Math.max(1, Math.round(mb(p.docker.memory) / 256)) : 0
const u = text.unit
---

<nav aria-label={text.project.map} class="flex flex-col gap-3">
	<p class="plate max-lg:hidden">{text.project.map}</p>

	<!-- componentes do chassi -->
	<div class="flex flex-col gap-3 rounded-[4px] border border-line-strong bg-surface-1 p-3 max-lg:hidden" aria-hidden="true">
		<div class="flex items-center justify-between gap-2">
			<span class="flex gap-0.5">{p.sources.map(() => <span class="h-4 w-2 rounded-[1px] border border-line-strong bg-surface-sunken" />)}</span>
			<span class="font-mono text-[10px] text-fg-subtle">{p.sources.length} {u.bays}</span>
		</div>
		<div class="flex items-center justify-between gap-2 border-t border-line-subtle pt-3">
			<span class="flex flex-wrap gap-1">{Array.from({ length: cpus }, () => <span class="grid size-4 place-items-center rounded-[2px] border border-fg-subtle bg-surface-2"><span class="size-1.5 rounded-[1px] bg-fg-faint" /></span>)}</span>
			<span class="font-mono text-[10px] text-fg-subtle">{p.docker.cpus || u.none} {u.cpus}</span>
		</div>
		<div class="flex items-center justify-between gap-2">
			<span class="flex flex-wrap gap-0.5">{Array.from({ length: dimms }, () => <span class="h-4 w-1 rounded-[1px] bg-fg-faint" />)}</span>
			<span class="font-mono text-[10px] text-fg-subtle">{p.docker.memory || u.none} {u.memory}</span>
		</div>
		<div class="flex items-center justify-between gap-2 border-t border-line-subtle pt-3">
			<span class="h-3 w-4 rounded-[2px] border border-brand" />
			<span class="font-mono text-[10px] text-fg-subtle">{p.docker.port ? `:${p.docker.port}` : u.none} {u.port}</span>
		</div>
	</div>

	<!-- compartimentos -->
	<ol class="flex gap-1 overflow-x-auto [scrollbar-width:none] lg:flex-col lg:gap-0 lg:overflow-visible lg:rounded-[4px] lg:border lg:border-line-strong lg:bg-surface-1">
		{
			parts.map((x) => (
				<li class="shrink-0 lg:border-b lg:border-line-subtle lg:last:border-b-0">
					<a
						href={`#${x.id}`}
						data-map={x.id}
						class={`group flex min-h-10 items-center gap-2.5 rounded-control border border-line px-3 text-sm whitespace-nowrap text-fg-muted hover:text-fg aria-[current=true]:border-brand/40 aria-[current=true]:text-fg lg:min-h-9 lg:rounded-none lg:border-0 lg:border-l-2 lg:border-l-transparent lg:aria-[current=true]:border-l-brand lg:aria-[current=true]:bg-white/[0.03] ${motion} ${focusRing}`}
					>
						<span class="font-mono text-[10px] tabular-nums text-fg-faint group-aria-[current=true]:text-brand">{x.code}</span>
						{x.title}
					</a>
				</li>
			))
		}
	</ol>
</nav>
