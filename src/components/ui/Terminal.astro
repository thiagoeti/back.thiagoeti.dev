---
import { inline } from '@/lib/markdown'
import { INLINE_CODE } from '@/lib/site'
import { text } from '@/lib/text'

/**
 * Terminal (THEME.md › Card Base + mono, referência "Terminal"): os comandos de `## Executar`, um por
 * linha com o prompt, e a linha `Saída:` como resposta. Comando quebrado com `\` continua sem prompt.
 */
interface Props {
  /** Sem título: a seção da página já nomeia o bloco. */
  title?: string
  run: string
  output?: string
  slug: string
}

const { title, run, output, slug } = Astro.props
const lines = run.split('\n')
---

<div class="h-full
  flex flex-col overflow-hidden
  bg-surface-sunken rounded-card border border-line">
  <header class="px-5 py-3 flex items-center justify-between gap-3 border-b border-line">
    {title ? <h2 class="eyebrow">{title}</h2> : <span class="flex gap-1.5" aria-hidden="true"><span class="size-2 bg-surface-3 rounded-full" /><span class="size-2 bg-surface-3 rounded-full" /><span class="size-2 bg-brand rounded-full" /></span>}
    <span class="font-mono text-[11px] text-fg-subtle">{text.project.tty} {slug}</span>
  </header>
  <pre class="px-5 py-4 flex-1 overflow-x-auto font-mono text-xs leading-relaxed text-fg"><code>{lines.map((l, i) => (
    <span class={`block whitespace-pre`}><span class="text-brand select-none" aria-hidden="true">{i > 0 && /\\\s*$/.test(lines[i - 1]!) ? '  ' : '❯ '}</span>{l}</span>
  ))}</code></pre>
  {
    output && (
      <p class={`px-5 py-3
        font-mono text-xs leading-relaxed text-fg-muted border-t border-line
        [&_code]:text-success
        ${INLINE_CODE}`}>
        <span class="text-success">[{text.project.output}] </span>
        <span set:html={inline(output)} />
      </p>
    )
  }
</div>
