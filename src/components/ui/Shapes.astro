---
import { TONE, type Shape } from '@/lib/glyphs'

/** Formas dentro de um `<svg>` já aberto: caminho, círculo ou retângulo de cantos vivos; um papel por traço. */
interface Props {
  shapes: Shape[]
}

const { shapes } = Astro.props
---

{
  shapes.map((s) =>
    s.d ? (
      <path d={s.d} class={TONE[s.tone]} vector-effect="non-scaling-stroke" />
    ) : s.w !== undefined ? (
      <rect x={s.x} y={s.y} width={s.w} height={s.h} class={TONE[s.tone]} vector-effect="non-scaling-stroke" />
    ) : (
      <circle cx={s.cx} cy={s.cy} r={s.r} class={TONE[s.tone]} vector-effect="non-scaling-stroke" />
    ),
  )
}
