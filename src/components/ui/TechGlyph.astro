---
import type { Project } from '@/lib/projects'
import { techGlyph, type Tone } from '@/lib/techglyph'

/**
 * Glifo de tecnologia do projeto (src/lib/techglyph.ts): moldura da linguagem, motivo do framework e
 * satélites das demais tecnologias. `live`: guarda um grupo para as partículas (`src/scripts/glyph.ts`).
 */
interface Props {
  project: Project
  class?: string
  live?: boolean
}

const { project: p, class: className, live = false } = Astro.props
const g = techGlyph(p)
const TONE: Record<Tone, string> = {
  frame: 'fill-none stroke-fg-muted stroke-[1.6]',
  faint: 'fill-none stroke-line-strong stroke-[1.2]',
  motif: 'fill-none stroke-brand stroke-[2.2]',
  motifFill: 'fill-brand',
  motifSoft: 'fill-brand/15',
  sat: 'fill-none stroke-info stroke-[1.6]',
  satFill: 'fill-info',
  dot: 'fill-fg',
  label: 'font-mono fill-fg-muted',
  tag: 'fill-surface-2 stroke-line-strong',
}
const label = [g.lang, ...g.sats.map((s) => s.name)].filter(Boolean)
const all = [...new Set([...label, ...p.technologies])].join(', ')
---

<svg viewBox="0 0 200 200" class:list={['overflow-visible', className]} stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={all} data-glyph={p.slug}>
  {
    g.els.map((e) =>
      e.tag === 'text' ? (
        <text {...e.a} class={TONE[e.tone]}>{e.text}</text>
      ) : e.tag === 'path' ? (
        <path {...e.a} class={TONE[e.tone]} />
      ) : e.tag === 'circle' ? (
        <circle {...e.a} class={TONE[e.tone]} />
      ) : e.tag === 'rect' ? (
        <rect {...e.a} class={TONE[e.tone]} />
      ) : (
        <line {...e.a} class={TONE[e.tone]} />
      ),
    )
  }
  {live && <g data-particles />}
</svg>
