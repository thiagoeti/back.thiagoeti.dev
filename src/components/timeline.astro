---
import { inline } from '../lib/markdown'
import { INLINE_CODE } from '../lib/site'

/**
 * Event Timeline (THEME.md › Event Timeline): os passos de `## Como funciona`, em ordem — o número é
 * o passo, porque o conteúdo é uma sequência.
 */
interface Props {
	/** Sem título: a seção da página já nomeia o bloco. */
	title?: string
	steps: string[]
}

const { title, steps } = Astro.props
---

<section class="flex h-full flex-col rounded-card border border-line bg-surface-1 p-6">
	{title && <h2 class="eyebrow mb-6">{title}</h2>}
	<ol class="relative flex flex-col gap-5 pl-5 before:absolute before:top-1.5 before:bottom-1.5 before:left-1 before:w-px before:bg-line">
		{
			steps.map((step, i) => (
				<li class={`relative flex flex-col gap-1`}>
					<span class:list={['absolute top-1.5 -left-[19px] size-1.5 rounded-full', i === steps.length - 1 ? 'bg-brand' : 'bg-info']} aria-hidden="true" />
					<span class={`text-sm leading-relaxed text-fg ${INLINE_CODE}`} set:html={inline(step)} />
					<span class="font-mono text-[11px] tabular-nums text-fg-subtle">{String(i + 1).padStart(2, '0')}/{String(steps.length).padStart(2, '0')}</span>
				</li>
			))
		}
	</ol>
</section>
