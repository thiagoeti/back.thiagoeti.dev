---
import { TONE, type Shape } from '../lib/glyphs'

/** Formas da gramática polar dentro de um `<svg>` já aberto: caminho ou círculo, um papel por traço. */
interface Props {
	shapes: Shape[]
}

const { shapes } = Astro.props
---

{
	shapes.map((s) =>
		s.d ? (
			<path d={s.d} class={TONE[s.tone]} vector-effect="non-scaling-stroke" />
		) : (
			<circle cx={s.cx} cy={s.cy} r={s.r} class={TONE[s.tone]} vector-effect="non-scaling-stroke" />
		),
	)
}
