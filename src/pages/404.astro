---
import Base from '../layouts/base.astro'
import Icon from '../components/icon.astro'
import Unit from '../components/unit.astro'
import { BUTTON, pageTitle } from '../lib/site'
import { text } from '../lib/text'

/**
 * 404 — slot vazio: o rack sem servidor neste endereço. Tampa cega com ventilação, o código no
 * lugar do número do servidor, o endereço procurado no visor (preenchido no cliente) e a volta ao rack.
 */
const t = text.notfound
const blank = { kind: 'server' as const, size: 2, top: 5, bottom: 4 }
const vent = { kind: 'nameplate' as const, size: 3, top: 3, bottom: 1 }
---

<Base title={pageTitle(t.title)} description={t.body} path="/404" noindex>
	<div class="mx-auto w-full max-w-[86rem] px-2 py-3 sm:px-4 lg:px-8 lg:py-6">
		<div class="overflow-clip rounded-[8px] border border-line-strong bg-surface-sunken">
			<Unit unit={blank} ears={false}>
				<div class="grid h-full grid-cols-[auto_minmax(0,1fr)] items-center gap-4 rounded-[3px] border border-dashed border-line-strong p-3 lg:px-4 lg:py-2">
					<span class="font-mono text-2xl leading-none font-medium tabular-nums text-fg-faint lg:text-[1.75rem]">{t.code}</span>
					<span class="flex min-w-0 flex-col gap-1">
						<h1 class="text-base font-semibold text-fg">{t.title}</h1>
						<span class="text-sm text-fg-muted">{t.body}</span>
					</span>
				</div>
			</Unit>
			<Unit unit={vent} ears={false}>
				<div class="flex h-full flex-col justify-center gap-4 rounded-[3px] border border-line bg-surface-1 bg-[repeating-linear-gradient(to_right,transparent_0_10px,var(--color-surface-sunken)_10px_14px)] p-4 lg:px-6">
					<p class="flex flex-wrap items-baseline gap-3 self-start rounded-[3px] border border-line bg-surface-sunken px-3 py-2">
						<span class="plate">{t.path}</span>
						<code class="font-mono text-sm break-all text-fg" data-path>/404</code>
					</p>
					<a href="/" class={`${BUTTON} self-start`}>
						<Icon name="layout-grid" class="size-4" />
						{t.cta}
					</a>
				</div>
			</Unit>
		</div>
	</div>
</Base>

<script>
	const el = document.querySelector<HTMLElement>('[data-path]')
	if (el && location.pathname !== '/404') el.textContent = location.pathname
</script>
