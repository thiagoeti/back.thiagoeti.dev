---
import Base from '@/layouts/base.astro'
import Badge from '@/components/ui/Badge.astro'
import CommandBar from '@/components/sections/CommandBar.astro'
import HeroSystems from '@/components/sections/HeroSystems.astro'
import Integration from '@/components/ui/Integration.astro'
import ShowcaseCard from '@/components/ui/ShowcaseCard.astro'
import { host, intro, meta } from '@/lib/content'
import { projects } from '@/lib/projects'
import { sourceRepos } from '@/lib/repos'
import { SITE, absoluteUrl } from '@/lib/site'
import { fill, text } from '@/lib/text'

/**
 * Capa (.analyse/design.md › Revisão 10): na abertura, um back-end em funcionamento desenhado em
 * glifos de sistema, com dados passando sem parar; depois a vitrine, um glifo de tecnologia por
 * projeto, sob o título com linha separadora; repositórios e palavras-chave. Busca e tags só na régua acima do
 * menu inferior. Comportamento em `src/scripts/systems.ts` e `src/scripts/home.ts`.
 */
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: intro.title,
    numberOfItems: projects.length,
    itemListElement: projects.map((p) => ({ '@type': 'ListItem', position: p.number, url: absoluteUrl(p.href), name: p.name })),
  },
]
const r = text.repos
const s = text.showcase
---

<Base title={intro.title} description={meta.description} path="/" jsonLd={jsonLd} dock>
  <div class="w-full max-w-[120rem] mx-auto px-4 pt-8 pb-16
    flex flex-col gap-10
    sm:px-6 lg:px-8 lg:pt-12">
    <!-- abertura -->
    <section aria-labelledby="titulo" class="flex flex-col gap-6">
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-end lg:gap-12">
        <div class="flex flex-col gap-3">
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 eyebrow">
            <span class="size-1.5 bg-brand rounded-full" aria-hidden="true"></span>
            <span>{SITE.role}</span>
          </p>
          <h1 id="titulo" class="display-xl lg:text-7xl">{intro.title}</h1>
        </div>
        <div class="max-w-xl flex flex-col gap-1 lg:pb-2">
          <p class="text-lg leading-snug text-fg">{intro.description}</p>
          <p class="body-md">{meta.description}</p>
        </div>
      </div>
      <HeroSystems />
    </section>

    <!-- vitrine -->
    <section aria-labelledby="vitrine" class="flex flex-col gap-6">
      <div class="flex items-center gap-4">
        <h2 id="vitrine" class="shrink-0 text-2xl font-medium tracking-tight text-fg">{s.title}</h2>
        <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
      </div>
      <p class="sr-only" aria-live="polite" data-shown>{fill(text.filter.count, { n: projects.length, total: projects.length })}</p>
      <ol class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
        {projects.map((p) => <ShowcaseCard project={p} />)}
      </ol>
      <p class="p-8
        hidden place-items-center gap-2
        text-center text-sm text-fg-subtle rounded-card border border-dashed border-line
        data-[show]:grid" data-empty>{text.search.empty}</p>
    </section>

    <!-- repositórios + palavras-chave -->
    <div class="mt-6 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <section aria-labelledby="repositorios" class="flex flex-col gap-5">
        <h2 id="repositorios" class="heading-panel">{r.title}</h2>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            sourceRepos.map((repo) => {
              const mine = projects.filter((p) => p.repo === repo)
              const facts = [
                [r.segment, repo.segment],
                [r.spec, repo.spec],
                [r.total, repo.total === null ? '' : String(repo.total)],
                [r.measured, repo.measured],
              ].filter((x): x is [string, string] => !!x[1])
              return (
                <li>
                  <Integration
                    name={repo.label}
                    icon="tech-github"
                    href={repo.url}
                    external
                    status={{ label: r.origins[repo.origin], tone: repo.origin === 'none' ? 'muted' : repo.origin === 'github' ? 'info' : 'success' }}
                    description={repo.description}
                    facts={facts}
                    footer={{ left: host(repo.url), right: fill(r.projects, { n: mine.length }) }}
                  />
                </li>
              )
            })
          }
        </ul>
      </section>
      <section aria-labelledby="palavras-chave" class="flex flex-col gap-5">
        <h2 id="palavras-chave" class="heading-panel">{text.keywords.title}</h2>
        <ul class="flex flex-wrap gap-2">
          {meta.keywords.map((w) => <li><Badge mono>{w}</Badge></li>)}
        </ul>
      </section>
    </div>
  </div>


  <CommandBar slot="dock" dock />
</Base>

<script>
  import '@/scripts/systems'
  import '@/scripts/home'
</script>
