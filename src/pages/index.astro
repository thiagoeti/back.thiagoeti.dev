---
import Base from '../layouts/base.astro'
import Faceplate from '../components/faceplate.astro'
import Nameplate from '../components/nameplate.astro'
import PatchPanel from '../components/patch-panel.astro'
import Pdu from '../components/pdu.astro'
import Storage from '../components/storage.astro'
import Switch from '../components/switch.astro'
import Unit from '../components/unit.astro'
import { intro, meta } from '../lib/content'
import { projects } from '../lib/projects'
import { HEIGHT, unitOf } from '../lib/rack'
import { sourceRepos } from '../lib/repos'
import { SITE, absoluteUrl, pageTitle } from '../lib/site'
import { fill, text } from '../lib/text'

/**
 * Capa: a frente do rack, de cima para baixo — chapa de identificação, patch panel (as tags),
 * bandeja de cabos, um servidor por projeto, uma gaveta de discos por repositório, a régua de
 * tomadas (palavras-chave) e o switch (ecossistema e contatos). À direita, o organizador vertical
 * por onde os cabos descem do patch panel até as placas de rede de cada servidor (desenhados em
 * `src/scripts/rack.ts`). Mobile: o patch panel vira a régua fixa acima do menu; o switch vai para
 * o botão Rede do cabeçalho; sem cabos, as portas acendem.
 */
const h = text.home

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: intro.title,
		numberOfItems: projects.length,
		itemListElement: projects.map((p) => ({ '@type': 'ListItem', position: p.number, url: absoluteUrl(p.href), name: p.name })),
	},
]
---

<Base title={pageTitle(intro.title)} description={meta.description} path="/" jsonLd={jsonLd} dock>
	<div class="mx-auto w-full max-w-[86rem] px-2 py-3 sm:px-4 lg:px-8 lg:py-6">
		<div class="relative" data-rack>
			<div class="overflow-clip rounded-[8px] border border-line-strong bg-surface-sunken">
				<!-- tampa -->
				<div class="flex min-h-8 flex-wrap items-center gap-x-3 gap-y-0.5 border-b border-line bg-surface-1 px-3 py-1.5 lg:px-4">
					<span class="plate shrink-0 text-fg-muted">{h.rack}</span>
					<span class="shrink-0 font-mono text-[11px] tabular-nums text-fg-subtle">{fill(h.units, { n: HEIGHT })}</span>
					<span class="order-last w-full text-xs text-fg-subtle sm:order-none sm:w-auto sm:min-w-0 sm:flex-1 sm:truncate">{meta.description}</span>
					<span class="ml-auto shrink-0 font-mono text-[11px] text-fg-subtle sm:ml-0">{SITE.host}</span>
				</div>

				<div class="flex">
					<div class="min-w-0 flex-1">
						<Unit unit={unitOf('nameplate')} ears={false}><Nameplate /></Unit>

						<Unit unit={unitOf('patch')} class="sticky top-16 z-20 bg-surface-sunken max-lg:hidden"><PatchPanel /></Unit>

						<Unit unit={unitOf('tray')} ears={false} class="max-lg:hidden">
							<div
								class="flex h-full min-h-10 items-center justify-end rounded-[3px] border border-line bg-surface-1 bg-[repeating-linear-gradient(to_right,transparent_0_46px,rgb(255_255_255/0.025)_46px_50px)] px-4"
								data-tray
							>
								<span class="font-mono text-[11px] text-fg-faint">{fill(h.hint, { n: projects.length })}</span>
							</div>
						</Unit>

						<div class="flex flex-col" data-servers>
							{
								projects.map((p) => (
									<Unit unit={unitOf('server', p.slug)}>
										<Faceplate project={p} unit={unitOf('server', p.slug)} />
									</Unit>
								))
							}
						</div>

						{
							sourceRepos.map((r) => (
								<Unit unit={unitOf('storage', r.name)}>
									<Storage repo={r} />
								</Unit>
							))
						}

						<Unit unit={unitOf('pdu')}><Pdu /></Unit>

						<Unit unit={unitOf('switch')} class="max-lg:hidden"><Switch /></Unit>
					</div>

					<!-- organizador vertical de cabos -->
					<div
						class="hidden w-12 shrink-0 border-l border-line bg-surface-1 bg-[repeating-linear-gradient(to_bottom,transparent_0_40px,var(--color-surface-sunken)_40px_48px)] lg:block"
						aria-hidden="true"
						data-channel
					>
					</div>
				</div>

				<!-- base -->
				<div class="flex h-6 items-end justify-between border-t border-line bg-surface-1 px-6" aria-hidden="true">
					<span class="h-2 w-10 rounded-t-[3px] bg-surface-3"></span>
					<span class="h-2 w-10 rounded-t-[3px] bg-surface-3"></span>
				</div>
			</div>

			<svg class="pointer-events-none absolute inset-0 z-10 hidden size-full overflow-visible lg:block" aria-hidden="true" data-cables></svg>
		</div>
	</div>

	<p class="pointer-events-none fixed bottom-[calc(8.5rem+env(safe-area-inset-bottom))] left-1/2 z-50 -translate-x-1/2 rounded-control border border-line-strong bg-surface-3 px-3 py-2 font-mono text-xs text-fg opacity-0 transition-opacity duration-300 data-[show]:opacity-100 lg:bottom-6" aria-live="polite" data-toast></p>

	<PatchPanel slot="dock" dock />
</Base>

<script>
	import '../scripts/rack'
</script>
