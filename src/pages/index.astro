---
import Base from '../layouts/base.astro'
import Dial from '../components/dial.astro'
import Glyph from '../components/glyph.astro'
import LinkRow from '../components/link-row.astro'
import Readout from '../components/readout.astro'
import TagBar from '../components/tag-bar.astro'
import { contacts, ecosystem, host, intro, meta, projectsTitle, titles } from '../lib/content'
import { grid } from '../lib/glyphs'
import { projects, totals } from '../lib/projects'
import { sourceRepos } from '../lib/repos'
import { SITE, absoluteUrl, focusRing, pageTitle } from '../lib/site'
import { fill, text } from '../lib/text'

/**
 * Capa: o mostrador. Desktop — três colunas sem rolagem: apresentação e fichas à esquerda, disco no
 * centro, leitor do cofre em foco à direita. Mobile — trilho horizontal de painéis: mostrador,
 * um leitor por projeto e, no fim, ecossistema, contatos e repositórios.
 */
const k = text.home.kpis
const kpis = [
	{ value: totals.projects, label: k.projects },
	{ value: totals.technologies, label: k.technologies },
	{ value: totals.tags, label: k.tags },
	{ value: totals.responses, label: k.responses },
	{ value: totals.negative, label: k.negative, key: true },
	{ value: totals.lines, label: k.lines },
]
const panel = 'flex h-full w-full shrink-0 snap-start flex-col overflow-y-auto [&>*]:shrink-0 overscroll-contain [scrollbar-width:thin]'

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: intro.title,
		numberOfItems: projects.length,
		itemListElement: projects.map((p) => ({ '@type': 'ListItem', position: p.index + 1, url: absoluteUrl(p.href), name: p.name })),
	},
]
---

<Base title={pageTitle(intro.title)} description={meta.description} path="/" jsonLd={jsonLd}>
	<TagBar slot="bar" live />

	<div
		data-track
		class="mx-auto flex h-full w-full max-w-[120rem] snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] lg:grid lg:grid-cols-[minmax(16rem,1fr)_minmax(0,2.4fr)_minmax(21rem,1fr)] lg:grid-rows-[auto_minmax(0,1fr)] lg:gap-x-10 lg:overflow-hidden lg:px-8 xl:gap-x-16"
	>
		<!-- painel 1: apresentação + mostrador -->
		<section class:list={[panel, 'gap-4 px-4 pt-5 sm:px-8 lg:contents']} aria-labelledby="titulo">
			<div class="lg:col-start-1 lg:row-start-1 lg:pt-8">
				<p class="eyebrow">{SITE.brand} · {SITE.role}</p>
				<h1 id="titulo" class="mt-3 text-5xl leading-[1.05] font-normal tracking-tight text-fg lowercase">{intro.title}</h1>
				<p class="body-md mt-3 max-w-sm">{intro.description}</p>
				<dl class="mt-5 grid max-w-sm grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line max-lg:hidden">
					{
						kpis.map((x) => (
							<div class="flex flex-col-reverse justify-end gap-1 bg-surface-0 p-3">
								<dt class="text-[10px] uppercase leading-tight tracking-wider text-fg-subtle">{x.label}</dt>
								<dd class:list={['kpi-md', x.key && 'text-brand']}>{x.value}</dd>
							</div>
						))
					}
				</dl>
			</div>

			<div class="relative grid min-h-0 place-items-center overflow-hidden lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:overflow-visible lg:py-6">
				<Dial />
				<p data-toast data-withdraw={text.eggs.withdraw} data-pix={text.eggs.pix} data-console={text.eggs.console} aria-live="polite" class="pointer-events-none absolute inset-x-0 bottom-2 text-center text-[11px] text-brand opacity-0 transition-opacity duration-320"></p>
			</div>

			<dl class="grid grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line lg:hidden">
				{
					kpis.map((x) => (
						<div class="flex flex-col-reverse justify-end gap-1 bg-surface-0 p-2.5">
							<dt class="text-[10px] uppercase leading-tight tracking-wider text-fg-subtle">{x.label}</dt>
							<dd class:list={['kpi-md text-xl', x.key && 'text-brand']}>{x.value}</dd>
						</div>
					))
				}
			</dl>
			<p class="pb-4 text-right text-[11px] text-fg-subtle lg:hidden" aria-hidden="true">{text.home.swipe}</p>
		</section>

		<!-- painéis 2…n+1: leitores -->
		<div class="contents lg:col-start-3 lg:row-span-2 lg:row-start-1 lg:flex lg:min-h-0 lg:justify-end">
			{projects.map((p) => <Readout project={p} />)}
		</div>

		<!-- último painel: ecossistema (mobile), contatos, repositórios, índice -->
		<section class:list={[panel, 'gap-6 px-4 py-6 sm:px-8 lg:col-start-1 lg:row-start-2 lg:h-auto lg:min-h-0 lg:px-0 lg:pt-6 lg:pb-8']} aria-label={text.home.panels}>
			<nav aria-labelledby="ecossistema" class="lg:hidden">
				<h2 id="ecossistema" class="eyebrow mb-2">{titles.ecosystem}</h2>
				<ul class="grid gap-0.5 sm:grid-cols-2">
					{ecosystem.map((e) => <li><LinkRow item={e} /></li>)}
				</ul>
			</nav>

			<div>
				<h2 class="eyebrow mb-2">{titles.contacts}</h2>
				<ul class="grid max-w-sm gap-0.5">
					{contacts.map((c) => <li><LinkRow item={c} /></li>)}
				</ul>
			</div>

			<div>
				<h2 class="eyebrow mb-2">{projectsTitle} · {text.home.sources}</h2>
				<ul class="grid max-w-sm gap-2">
					{
						sourceRepos.map((r) => (
							<li>
								<a href={r.url} target="_blank" rel="noopener" class={`group flex items-start gap-3 rounded-card border border-line bg-surface-1 p-3 hover:border-line-strong ${focusRing}`}>
									<Glyph shapes={grid(12, 11)} size={24} class="mt-0.5 size-6" live={r.projects.length > 0} />
									<span class="min-w-0 flex-1">
										<span class="flex items-baseline justify-between gap-2">
											<span class="text-xs font-semibold text-fg group-hover:text-brand">{r.label}</span>
											<span class="text-[11px] tabular-nums text-fg-subtle">{fill(text.home.projectsCount, { n: r.projects.length })}</span>
										</span>
										<span class="block truncate text-[11px] text-fg-subtle">{host(r.url)}</span>
										{r.description && <span class="mt-1 block text-[11px] leading-snug text-fg-muted">{r.description}</span>}
										{(r.measured || r.spec || r.segment) && (
											<span class="mt-1 flex flex-wrap gap-x-3 text-[10px] text-fg-faint">
												{r.segment && <span>{r.segment}</span>}
												{r.measured && <span>{text.home.measured} {r.measured}</span>}
												{r.spec && <span>{text.home.spec} {r.spec}</span>}
												{r.total !== null && <span>{text.home.total} {r.total}</span>}
											</span>
										)}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="eyebrow mb-2">{text.home.keywords}</h2>
				<ul class="flex max-w-sm flex-wrap gap-x-3 gap-y-1 text-[11px] text-fg-subtle">
					{meta.keywords.map((w) => <li>{w}</li>)}
				</ul>
			</div>

			<p class="hidden text-[11px] text-fg-faint lg:block">{fill(text.home.hint, { n: projects.length })}</p>
		</section>
	</div>
</Base>

<script>
	import '../scripts/dial'
</script>
