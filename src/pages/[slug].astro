---
import Base from '@/layouts/base.astro'
import Badge from '@/components/ui/Badge.astro'
import BoardDiagram from '@/components/sections/BoardDiagram.astro'
import Icon from '@/components/ui/Icon.astro'
import Integration from '@/components/ui/Integration.astro'
import Sheet from '@/components/sections/Sheet.astro'
import Showcase from '@/components/sections/Showcase.astro'
import Skills from '@/components/sections/Skills.astro'
import SourcePanel from '@/components/sections/SourcePanel.astro'
import TechGlyph from '@/components/ui/TechGlyph.astro'
import Terminal from '@/components/ui/Terminal.astro'
import ThreatConsole from '@/components/sections/ThreatConsole.astro'
import Timeline from '@/components/ui/Timeline.astro'
import { host } from '@/lib/content'
import { finalBalance, parseBurst } from '@/lib/burst'
import { SHIELD } from '@/lib/docker'
import { inline, renderMarkdown } from '@/lib/markdown'
import { projects, vicinity, type Project } from '@/lib/projects'
import { knownOf, type Known } from '@/lib/readme'
import { INLINE_CODE, PROSE, SITE, absoluteUrl, focusRing, motion } from '@/lib/site'
import { text } from '@/lib/text'
import { tracks } from '@/lib/tracks'

/**
 * Página do projeto (.analyse/design.md › Revisão 10, apresentação no padrão do front): trilha, título e descrição
 * lado a lado; vitrine com a janela do GitHub (glifo vivo, `git clone`) e os relacionados em grafo; depois cenário,
 * diagrama, como funciona e executar, blindagem e container, ficha em terminal e código, trade-offs, skills, links e
 * vizinhos. Seção sem dado não entra.
 */
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}

interface Props {
  project: Project
}

const { project: p } = Astro.props
const t = text.project
const u = text.unit
const { next, prev } = vicinity(p)
const dash = u.none
const titleOf = (k: Known) => p.doc.parts.find((x) => knownOf(x.title) === k)?.title ?? k

const burst = parseBurst(p.doc.output)
const balance = finalBalance(p.doc.output, p.doc.scenario)
const scene = p.doc.diagram ? tracks(p.doc.diagram) : null
const known = new Set<Known>(['Diagrama', 'Cenário', 'Como funciona', 'Executar', 'Skills', 'Trade-offs'])
/** Seção do README só de links (`## Projeto`) já está nos Links e na ficha. */
const onlyLinks = (body: string) => body.split('\n').every((l) => !l.trim() || /^\s*[-*]\s+\[[^\]]+\]\([^)]+\)\s*$/.test(l))
const extra = await Promise.all(p.doc.parts.filter((x) => (!knownOf(x.title) || !known.has(knownOf(x.title)!)) && !onlyLinks(x.body)).map(async (x) => ({ title: x.title, html: await renderMarkdown(x.body) })))
const LANG: Record<string, string> = { php: 'php', py: 'python', ts: 'ts', js: 'js', sh: 'sh', json: 'json', yml: 'yaml', yaml: 'yaml', toml: 'toml', txt: 'txt' }
const sources = await Promise.all(p.sources.map(async (f) => ({ ...f, html: await renderMarkdown(`\`\`\`${LANG[f.path.split('.').pop() ?? ''] ?? 'txt'}\n${f.code.trimEnd()}\n\`\`\``) })))

const links = [
  { label: t.framework, href: p.refs.framework, icon: 'layers' as const },
  { label: t.library, href: p.refs.library, icon: 'code-xml' as const },
  { label: t.site, href: p.refs.link, icon: 'globe' as const },
  { label: t.docs, href: p.refs.docs, icon: 'file-code' as const },
  { label: t.mcp, href: p.refs.mcp, icon: 'cpu' as const },
  ...p.context7.map((id) => ({ label: `${t.context7} ${id}`, href: `https://context7.com${id}`, icon: 'search' as const })),
  { label: t.folder, href: p.github.folder, icon: 'tech-github' as const },
  { label: t.repository, href: p.github.folder.split('/tree/')[0], icon: 'git-branch' as const },
  { label: t.readme, href: p.github.readme, icon: 'file-code' as const },
  { label: p.script || t.docker, href: p.github.docker, icon: 'container' as const },
  { label: t.page, href: absoluteUrl(p.href), icon: 'globe' as const },
].filter((x) => x.href)
const machine = [
  { label: u.image, value: p.docker.image || dash },
  { label: u.cpus, value: p.docker.cpus || dash },
  { label: u.memory, value: p.docker.memory || dash },
  { label: u.swap, value: p.docker.swap || dash },
  { label: u.port, value: p.docker.port ? `:${p.docker.port}` : dash },
  { label: u.pids, value: p.docker.pids || dash },
  { label: u.nofile, value: p.docker.nofile || dash },
  { label: u.user, value: p.docker.user || dash },
  { label: u.restart, value: p.docker.restart || dash },
  { label: u.stop, value: p.docker.stopSignal ? `${p.docker.stopSignal}${p.docker.stopTimeout ? ` ${p.docker.stopTimeout}s` : ''}` : dash },
  { label: u.health, value: p.docker.healthInterval || dash },
  { label: u.log, value: p.docker.log || dash },
]
/** Números da abertura: só os que o projeto tem. */
const read = [
  burst && { k: text.burst.accepted, v: String(burst.ok), tone: 'text-success' },
  burst && { k: text.burst.refused, v: String(burst.refused + burst.failed), tone: burst.refused ? 'text-warning' : 'text-fg-faint' },
  balance && { k: text.burst.balance, v: balance, tone: 'text-fg' },
  p.github.docker && { k: text.armor, v: `${p.armor}/${SHIELD.length}`, tone: p.armor === SHIELD.length ? 'text-brand' : 'text-danger' },
  { k: u.files, v: String(p.sources.length + (p.readme ? 1 : 0)), tone: 'text-fg' },
  { k: u.lines, v: String(p.lines), tone: 'text-fg' },
].filter((x): x is { k: string; v: string; tone: string } => !!x)

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: p.name,
    description: p.description,
    url: absoluteUrl(p.href),
    codeRepository: p.github.folder,
    programmingLanguage: p.technologies,
    keywords: p.tags.join(', '),
    creativeWorkStatus: p.wip ? t.wip : t.stable,
    author: { '@type': 'Person', name: SITE.author, url: SITE.home },
  },
]
const LIST_ROW = `min-w-0 px-3 py-2.5
  flex items-center justify-between gap-4
  bg-surface-2/60 rounded-control border border-line-subtle`
const H2 = 'flex items-center gap-3 heading-panel'
---

<Base title={p.name} description={p.description} path={p.href} image={`/${p.slug}/og.png`} jsonLd={jsonLd}>
  <div class="w-full max-w-[120rem] mx-auto px-4 pt-8 pb-16
    flex flex-col gap-10
    sm:px-6 lg:px-8 lg:pt-12">
    <nav aria-label={t.crumb} class="font-mono text-xs text-fg-subtle">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class={`min-h-11 flex items-center gap-2 hover:text-fg
            ${motion}
            ${focusRing}`}>
            <Icon name="arrow-left" class="size-3.5" />
            {t.crumb}
          </a>
        </li>
        <li aria-hidden="true" class="text-fg-faint">/</li>
        <li aria-current="page" class="text-fg">{p.title}</li>
      </ol>
    </nav>

    <!-- abertura: título à esquerda, descrição e números à direita -->
    <header class="grid grid-cols-1 gap-6
      lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-end lg:gap-16">
      <div class="flex flex-col gap-4">
        <p class="flex flex-wrap items-center gap-3">
          <span class="flex items-center gap-2 mono-label">
            <span class:list={['size-1.5 rounded-full', p.github.docker ? 'bg-brand' : 'bg-info']} aria-hidden="true"></span>
            {p.path}
          </span>
          {p.wip && <Badge tone="warning" dot>{t.wip}</Badge>}
        </p>
        <hgroup class="contents">
          <h1 id="titulo" class="display-xl [view-transition-name:project] lg:text-7xl">{p.title}</h1>
          {p.subtitle && <p class="text-xl leading-snug text-fg-muted">{p.subtitle}</p>}
        </hgroup>
      </div>
      <div class="flex flex-col gap-5">
        <p class="text-lg leading-relaxed text-fg">{p.description}</p>
        {p.doc.intro && p.doc.intro !== p.description && <p class={`body-md ${INLINE_CODE}`} set:html={inline(p.doc.intro)} />}
        <dl class="grid grid-cols-2 gap-px overflow-hidden
          bg-line rounded-card border border-line
          sm:grid-cols-3">
          {
            read.map((r) => (
              <div class="min-w-0 px-4 py-3 flex flex-col gap-1 bg-surface-1">
                <dt class="text-[10px] uppercase text-fg-subtle">{r.k}</dt>
                <dd class:list={['truncate font-mono text-lg leading-none tabular-nums', r.tone]}>{r.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <!-- vitrine: janela do GitHub com o glifo vivo e os relacionados em grafo -->
    <Showcase project={p} />

    <!-- cenário e saída -->
    {(p.doc.scenario || p.doc.output) && (
    <section id="respostas" aria-labelledby="respostas-titulo" class="p-6 flex flex-col gap-4 bg-surface-1 rounded-card border border-line">
      <h2 id="respostas-titulo" class={H2}>{titleOf('Cenário')}</h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="flex flex-col gap-2">
          <p class={`text-base leading-relaxed text-fg ${INLINE_CODE}`} set:html={p.doc.scenario ? inline(p.doc.scenario) : dash} />
        </div>
        <div class="p-4 flex flex-col gap-2 bg-surface-sunken rounded-control border border-line">
          <p class="eyebrow">{t.output}</p>
          <p class={`font-mono text-sm leading-relaxed text-fg-muted [&_code]:text-success
            ${INLINE_CODE}`}><samp set:html={p.doc.output ? inline(p.doc.output) : dash} /></p>
        </div>
      </div>
      {
        burst && (
          <ol class="pt-4 flex flex-wrap gap-1.5 border-t border-line-subtle" aria-label={text.burst.sequence}>
            {burst.hits.map((h) => (
              <li>
                <Badge tone={h.code.startsWith('2') ? 'success' : h.code.startsWith('4') ? 'warning' : 'danger'} mono>
                  {h.count > 1 ? `${h.count}× ` : ''}
                  {h.code}
                  {h.label ? ` ${h.label}` : ''}
                </Badge>
              </li>
            ))}
          </ol>
        )
      }
    </section>
    )}

    <!-- diagrama -->
    {
      scene && (
        <div class="flex flex-col gap-4">
          <BoardDiagram title={titleOf('Diagrama')} scene={scene} source={p.doc.diagram} />
        </div>
      )
    }

    <!-- como funciona + executar -->
    {
      (p.doc.steps.length > 0 || p.doc.run) && (
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          {p.doc.steps.length > 0 && (
            <section aria-labelledby="como-funciona" class="flex flex-col gap-4 lg:col-span-5">
              <h2 id="como-funciona" class="heading-panel">{titleOf('Como funciona')}</h2>
              <Timeline steps={p.doc.steps} />
            </section>
          )}
          {p.doc.run && (
            <section aria-labelledby="executar" class:list={['flex flex-col gap-4', p.doc.steps.length ? 'lg:col-span-7' : 'lg:col-span-12']}>
              <h2 id="executar" class="heading-panel">{titleOf('Executar')}</h2>
              <Terminal run={p.doc.run} output={p.doc.output} slug={p.slug} />
              {p.doc.note && <p class={`max-w-3xl body-sm ${INLINE_CODE}`} set:html={inline(p.doc.note)} />}
            </section>
          )}
        </div>
      )
    }

    <!-- blindagem -->
    {p.github.docker && (
    <div class="flex flex-col gap-4">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
        <ThreatConsole project={p} />
        <section aria-labelledby="container-titulo" class="p-6 flex flex-col gap-4 bg-surface-1 rounded-card border border-line">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 id="container-titulo" class="heading-panel">{t.container}</h3>
            {!p.github.docker && <Badge tone="info" dot>{t.noContainer}</Badge>}
          </div>
          <dl class="flex flex-col gap-1.5">
            {machine.map((x) => (
              <div class={LIST_ROW}>
                <dt class="shrink-0 text-sm text-fg-muted">{x.label}</dt>
                <dd class="min-w-0 truncate text-right font-mono text-xs font-medium text-fg">{x.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </div>
    )}

    <!-- ficha em terminal + código -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <Sheet project={p} />
      {sources.length > 0 && <SourcePanel files={sources} lines={p.lines} bytes={p.bytes} />}
    </div>

    <!-- trade-offs -->
    {
      p.doc.tradeoffs.rows.length > 0 && (
        <section aria-labelledby="trade-offs-titulo" class="p-6 bg-surface-1 rounded-card border border-line">
          <h2 id="trade-offs-titulo" class="mb-6 heading-panel">{titleOf('Trade-offs')}</h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {[0, 1].map((col) => (
              <div class="flex flex-col gap-2">
                <p class="flex items-center justify-between">
                  <span class="eyebrow">{p.doc.tradeoffs.head[col] ?? (col ? t.drawback : t.advantage)}</span>
                  <Badge tone={col ? 'warning' : 'success'} mono>{p.doc.tradeoffs.rows.filter((r) => r[col]).length}</Badge>
                </p>
                <ul class="flex flex-col gap-2">
                  {p.doc.tradeoffs.rows
                    .map((r) => r[col] ?? '')
                    .filter(Boolean)
                    .map((x) => (
                      <li class:list={['p-4 flex gap-3 text-sm leading-relaxed rounded-control border', col ? 'bg-warning/[0.06] text-fg-muted border-warning/30' : 'bg-surface-2/60 text-fg border-line-subtle', INLINE_CODE]}>
                        <span class:list={['size-1.5 mt-2 shrink-0 rounded-full', col ? 'bg-warning' : 'bg-success']} aria-hidden="true" />
                        <span set:html={inline(x)} />
                      </li>
                    ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- skills -->
    <Skills project={p} title={titleOf('Skills')} />

    {
      extra.map((x) => (
        <section class="p-6 bg-surface-1 rounded-card border border-line">
          <h2 class="mb-4 heading-panel">{x.title}</h2>
          <div class:list={[PROSE, 'max-w-3xl text-base']} set:html={x.html} />
        </section>
      ))
    }

    <!-- links -->
    <section aria-labelledby="links-titulo" class="flex flex-col gap-4">
      <h2 id="links-titulo" class="heading-panel">{t.links}</h2>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
        {links.map((x) => (
          <li>
            <Integration name={x.label} icon={x.icon} href={x.href} external footer={{ left: host(x.href) }} />
          </li>
        ))}
      </ul>
    </section>

    <nav aria-label={`${t.prev} / ${t.next}`} class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        [
          { p: prev, label: t.prev, icon: 'arrow-left' as const },
          { p: next, label: t.next, icon: 'arrow-right' as const },
        ].map((n) => (
          <a href={n.p.href} data-neighbor class={`min-w-0 p-4
            grid grid-cols-[4rem_minmax(0,1fr)] items-center gap-4
            bg-surface-1 rounded-card border border-line
            hover:border-line-strong group
            ${motion}
            ${focusRing}`}>
            <TechGlyph project={n.p} class="size-16" />
            <span class="min-w-0 flex flex-col gap-1">
              <span class="flex items-center gap-2 eyebrow">
                <Icon name={n.icon} class="size-3.5 text-fg-subtle group-hover:text-brand" />
                {n.label}
              </span>
              <span class="truncate heading-card">{n.p.title}</span>
              {n.p.subtitle && <span class="truncate text-sm text-fg-muted">{n.p.subtitle}</span>}
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</Base>

<script>
  import '@/scripts/glyph'
  import '@/scripts/project'
</script>
