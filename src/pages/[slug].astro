---
import Base from '../layouts/base.astro'
import BoardDiagram from '../components/board-diagram.astro'
import ChassisMap from '../components/chassis-map.astro'
import Compartment from '../components/compartment.astro'
import Faceplate from '../components/faceplate.astro'
import Icon from '../components/icon.astro'
import Leds from '../components/leds.astro'
import Unit from '../components/unit.astro'
import { host } from '../lib/content'
import { SHIELD } from '../lib/docker'
import { inline, renderMarkdown } from '../lib/markdown'
import { projects, tagOf, vicinity, type Project } from '../lib/projects'
import { slot, unitOf } from '../lib/rack'
import { knownOf } from '../lib/readme'
import { BUTTON, INLINE_CODE, PROSE, SITE, absoluteUrl, focusRing, motion, pageTitle } from '../lib/site'
import { fill, text } from '../lib/text'
import { tracks } from '../lib/tracks'

/**
 * Página do projeto: o servidor puxado para fora do rack. No alto, a mesma chapa que foi clicada na
 * capa (view transition `server`); embaixo, o chassi aberto visto de cima, da frente para a
 * traseira — um compartimento por parte: Frente (dados e blindagem), cada seção do README na ordem
 * dele, Código (as baias, um arquivo por baia) e Traseira (portas = links, servidores vizinhos).
 * À esquerda, o mapa do chassi aponta o compartimento à vista.
 */
export function getStaticPaths() {
	return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}

interface Props {
	project: Project
}

const { project: p } = Astro.props
const t = text.project
const u = text.unit
const unit = unitOf('server', p.slug)
const { next, prev } = vicinity(p)
const dash = u.none

const slugify = (s: string) =>
	s
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '')

const readme = await Promise.all(p.doc.parts.map(async (part) => ({ ...part, id: slugify(part.title), kind: knownOf(part.title), html: await renderMarkdown(part.body) })))
const LANG: Record<string, string> = { php: 'php', py: 'python', ts: 'ts', js: 'js', sh: 'sh', json: 'json', yml: 'yaml', yaml: 'yaml', toml: 'toml', txt: 'txt' }
const sources = await Promise.all(
	p.sources.map(async (f) => ({ ...f, html: await renderMarkdown(`\`\`\`${LANG[f.path.split('.').pop() ?? ''] ?? 'txt'}\n${f.code.trimEnd()}\n\`\`\``) })),
)
const run = p.doc.run ? await renderMarkdown(`\`\`\`sh\n${p.doc.run}\n\`\`\``) : ''
const scene = p.doc.diagram ? tracks(p.doc.diagram) : null

const parts = [
	{ id: 'frente', title: t.front },
	...readme.map((x) => ({ id: x.id, title: x.title })),
	...(sources.length ? [{ id: 'codigo', title: t.code }] : []),
	{ id: 'traseira', title: t.rear },
].map((x, i) => ({ ...x, code: `J${i + 1}` }))
const code = (id: string) => parts.find((x) => x.id === id)?.code ?? ''

const kb = (b: number) => (b < 1024 ? `${b} B` : `${(b / 1024).toFixed(1)} KB`)
const links = [
	{ label: t.folder, href: p.github.folder, icon: 'tech-github' as const },
	{ label: t.repository, href: p.repo.url, icon: 'git-branch' as const },
	{ label: t.readme, href: p.github.readme, icon: 'file-code' as const },
	{ label: t.docker, href: p.github.docker, icon: 'terminal' as const },
	{ label: t.page, href: absoluteUrl(p.href), icon: 'globe' as const },
]
const facts = [
	{ label: t.path, value: p.path },
	{ label: t.segment, value: p.repo.segment || dash },
	{ label: t.status, value: p.wip ? t.wip : t.stable },
	{ label: text.home.measured, value: p.repo.measured || dash },
	{ label: text.home.spec, value: p.repo.spec || dash },
	{ label: t.slot, value: slot(unit) },
	{ label: u.tags, value: p.tags.length },
	{ label: u.steps, value: p.doc.steps.length },
	{ label: u.files, value: p.sources.length || dash },
	{ label: u.lines, value: p.lines || dash },
]
const machine = [
	{ label: u.image, value: p.docker.image || dash },
	{ label: u.cpus, value: p.docker.cpus || dash },
	{ label: u.memory, value: p.docker.memory || dash },
	{ label: u.swap, value: p.docker.swap || dash },
	{ label: u.port, value: p.docker.port ? `:${p.docker.port}` : dash },
	{ label: u.pids, value: p.docker.pids || dash },
	{ label: u.nofile, value: p.docker.nofile || dash },
	{ label: u.user, value: p.docker.user || dash },
	{ label: u.restart, value: p.docker.restart || dash },
	{ label: u.stop, value: p.docker.stopSignal ? `${p.docker.stopSignal}${p.docker.stopTimeout ? ` · ${p.docker.stopTimeout}s` : ''}` : dash },
	{ label: u.health, value: p.docker.healthInterval || dash },
	{ label: u.log, value: p.docker.log || dash },
]

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareSourceCode',
		name: p.name,
		description: p.description,
		url: absoluteUrl(p.href),
		codeRepository: p.github.folder,
		programmingLanguage: p.technologies,
		keywords: p.tags.join(', '),
		creativeWorkStatus: p.wip ? t.wip : t.stable,
		author: { '@type': 'Person', name: SITE.author, url: SITE.home },
	},
]
const DL = 'flex min-w-0 items-baseline justify-between gap-3 border-b border-line-subtle py-2 text-sm'
---

<Base title={pageTitle(p.name)} description={p.description} path={p.href} image={`/${p.slug}/og.png`} jsonLd={jsonLd}>
	<div class="mx-auto w-full max-w-[86rem] px-2 py-3 sm:px-4 lg:px-8 lg:py-6">
		<!-- o servidor puxado: a chapa e os trilhos -->
		<div class="overflow-clip rounded-t-[8px] border border-line-strong bg-surface-sunken">
			<Unit unit={unit}><Faceplate project={p} unit={unit} page /></Unit>
		</div>

		<!-- o chassi aberto -->
		<div class="grid gap-4 border-x border-b border-line-strong bg-surface-sunken p-2 sm:p-3 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-6 lg:p-6">
			<aside class="min-w-0 lg:sticky lg:top-22 lg:self-start">
				<ChassisMap project={p} parts={parts} />
			</aside>

			<article class="min-w-0 rounded-[4px] border border-line-strong bg-surface-1">
				<Compartment id="frente" code={code('frente')} title={t.front}>
					<p class="max-w-3xl text-base leading-relaxed text-fg">{p.description}</p>
					{p.doc.intro && <p class={`max-w-3xl border-l-2 border-line-strong pl-4 text-sm leading-relaxed text-fg-muted ${INLINE_CODE}`} set:html={inline(p.doc.intro)} />}

					<div class="grid gap-x-10 gap-y-6 xl:grid-cols-2">
						<dl>
							{
								facts.map((x) => (
									<div class={DL}>
										<dt class="shrink-0 text-fg-subtle">{x.label}</dt>
										<dd class="min-w-0 text-right font-mono text-xs break-all text-fg">{x.value}</dd>
									</div>
								))
							}
						</dl>
						<dl>
							{
								machine.map((x) => (
									<div class={DL}>
										<dt class="shrink-0 text-fg-subtle">{x.label}</dt>
										<dd class="min-w-0 text-right font-mono text-xs break-all text-fg">{x.value}</dd>
									</div>
								))
							}
						</dl>
					</div>

					<div>
						<p class="plate mb-2">{u.security} {p.armor}/{SHIELD.length}</p>
						<Leds docker={p.docker} list />
					</div>

					<div class="grid gap-6 sm:grid-cols-2">
						<div>
							<p class="plate mb-2">{u.tags}</p>
							<ul class="grid gap-1">
								{
									p.tags.map((x) => (
										<li>
											<a href={`/?tag=${encodeURIComponent(x)}`} class={`group/jack flex min-h-10 items-center gap-3 border-b border-line-subtle text-sm text-fg-muted hover:text-fg ${motion} ${focusRing}`} data-on>
												<span class="w-6 font-mono text-[11px] tabular-nums text-brand">{tagOf(x)?.label}</span>#{x}
												<span class="ml-auto font-mono text-xs text-fg-faint">×{tagOf(x)?.count}</span>
											</a>
										</li>
									))
								}
							</ul>
						</div>
						<div>
							<p class="plate mb-2">{u.technologies}</p>
							<ul class="grid gap-1">
								{p.technologies.map((x) => <li class="flex min-h-10 items-center border-b border-line-subtle font-mono text-sm text-fg">{x}</li>)}
							</ul>
						</div>
					</div>
				</Compartment>

				{
					readme.map((part) => (
						<Compartment id={part.id} code={code(part.id)} title={part.title}>
							{part.kind === 'Diagrama' && scene ? (
								<BoardDiagram scene={scene} source={p.doc.diagram} />
							) : part.kind === 'Como funciona' && p.doc.steps.length ? (
								<ol class="relative grid gap-5 pl-10 before:absolute before:top-2 before:bottom-2 before:left-3.5 before:w-px before:bg-line-strong">
									{p.doc.steps.map((step, i) => (
										<li class="relative">
											<span class="absolute top-0 -left-10 grid size-7 place-items-center rounded-full border border-fg-subtle bg-surface-1 font-mono text-xs tabular-nums text-fg">{i + 1}</span>
											<p class={`pt-1 text-sm leading-relaxed text-fg-muted lg:text-base ${INLINE_CODE}`} set:html={inline(step)} />
										</li>
									))}
								</ol>
							) : part.kind === 'Executar' && run ? (
								<div class="overflow-hidden rounded-[4px] border border-line-strong bg-surface-sunken">
									<p class="flex items-center gap-2 border-b border-line px-3 py-2 font-mono text-[11px] text-fg-subtle">
										<span class="size-1.5 rounded-full bg-brand" />
										{t.tty} · {p.slug}
									</p>
									<div class:list={[PROSE, 'overflow-x-auto px-3 py-3 [&_pre]:my-0! [&_pre]:border-0! [&_pre]:bg-transparent! [&_pre]:p-0!']} set:html={run} />
									{p.doc.output && (
										<p class={`border-t border-line px-3 py-3 font-mono text-xs leading-relaxed text-brand [&_code]:text-brand ${INLINE_CODE}`} set:html={inline(p.doc.output)} />
									)}
								</div>
							) : part.kind === 'Skills' && p.doc.skills.rows.length ? (
								<dl class="grid">
									{p.doc.skills.rows.map((row) => (
										<div class="grid gap-1 border-b border-line-subtle py-3 first:pt-0 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-6">
											<dt class="text-sm font-medium text-fg">{row[0]}</dt>
											<dd class={`text-sm leading-relaxed text-fg-muted [&_a]:text-brand [&_a]:underline [&_a]:underline-offset-4 ${INLINE_CODE}`} set:html={inline(row[1] ?? '')} />
										</div>
									))}
								</dl>
							) : part.kind === 'Trade-offs' && p.doc.tradeoffs.rows.length ? (
								<div class="grid gap-6 sm:grid-cols-2">
									{[0, 1].map((col) => (
										<div>
											<p class:list={['mb-2 flex items-center gap-2.5 text-sm font-medium', col ? 'text-fg-muted' : 'text-fg']}>
												<span class:list={['size-2.5 rounded-full', col ? 'border border-fg-faint' : 'bg-brand']} />
												{p.doc.tradeoffs.head[col]}
											</p>
											<ul class="grid">
												{p.doc.tradeoffs.rows
													.map((r) => r[col] ?? '')
													.filter(Boolean)
													.map((x) => (
														<li class={`border-b border-line-subtle py-3 text-sm leading-relaxed text-fg-muted ${INLINE_CODE}`} set:html={inline(x)} />
													))}
											</ul>
										</div>
									))}
								</div>
							) : (
								<div class:list={[PROSE, 'max-w-3xl']} set:html={part.html} />
							)}
						</Compartment>
					))
				}

				{
					sources.length > 0 && (
						<Compartment id="codigo" code={code('codigo')} title={t.code}>
							<p class="font-mono text-xs tabular-nums text-fg-subtle">{fill(t.files, { n: sources.length, lines: p.lines, bytes: kb(p.bytes) })}</p>
							<ul class="grid gap-1.5">
								{sources.map((f) => (
									<li>
										<details class="group rounded-[3px] border border-line-strong bg-linear-to-b from-surface-3 to-surface-2 open:bg-none open:bg-surface-sunken">
											<summary class={`flex min-h-11 cursor-pointer list-none items-center gap-3 px-3 text-sm ${focusRing}`}>
												<span class="flex h-6 w-3 shrink-0 flex-col justify-end rounded-[2px] border border-line-strong bg-surface-sunken p-px">
													<span class="h-1/2 w-full rounded-[1px] bg-fg-faint group-open:h-full group-open:bg-brand" />
												</span>
												<span class="min-w-0 flex-1 truncate font-mono text-xs text-fg-muted group-open:text-fg">{f.path}</span>
												<span class="shrink-0 font-mono text-xs tabular-nums text-fg-faint">
													{f.lines} · {kb(f.bytes)}
												</span>
											</summary>
											<div class:list={[PROSE, 'border-t border-line px-3 py-3 [&_pre]:my-0! [&_pre]:border-0! [&_pre]:bg-transparent! [&_pre]:p-0! [&_pre]:text-[11px]!']} set:html={f.html} />
										</details>
									</li>
								))}
							</ul>
						</Compartment>
					)
				}

				<Compartment id="traseira" code={code('traseira')} title={t.rear}>
					<div>
						<p class="plate mb-2">{t.links}</p>
						<ul class="grid gap-x-8 sm:grid-cols-2">
							{
								links.map((x) => (
									<li>
										<a href={x.href} target="_blank" rel="noopener" class={`group/jack flex min-h-11 items-center gap-3 border-b border-line-subtle text-sm ${motion} ${focusRing}`}>
											<Icon name={x.icon} class="size-4 text-fg-subtle group-hover/jack:text-brand" />
											<span class="w-24 shrink-0 text-fg-subtle">{x.label}</span>
											<span class="min-w-0 truncate font-mono text-xs text-fg-muted group-hover/jack:text-fg">{host(x.href)}</span>
										</a>
									</li>
								))
							}
						</ul>
					</div>

					<div class="grid gap-2 sm:grid-cols-2">
						{
							[
								{ p: prev, label: t.above, icon: 'arrow-left' as const },
								{ p: next, label: t.below, icon: 'arrow-right' as const },
							].map((n) => (
								<a href={n.p.href} class={`group flex items-center gap-4 rounded-[3px] border border-line-strong bg-linear-to-b from-surface-3 to-surface-2 p-3 hover:border-fg-faint ${motion} ${focusRing}`}>
									<span class="font-mono text-xl tabular-nums text-fg">{n.p.serial}</span>
									<span class="flex min-w-0 flex-col">
										<span class="plate">{n.label}</span>
										<span class="truncate text-sm font-semibold text-fg">{n.p.title}</span>
										<span class="truncate text-xs text-fg-muted">{n.p.subtitle}</span>
									</span>
									<Icon name={n.icon} class="ml-auto size-4 shrink-0 text-fg-subtle group-hover:text-brand" />
								</a>
							))
						}
					</div>
					<a href="/" class={`${BUTTON} self-start`}>
						<Icon name="layout-grid" class="size-4" />
						{t.back}
					</a>
				</Compartment>
			</article>
		</div>
	</div>
</Base>

<script>
	import '../scripts/chassis'
</script>
