---
import Base from '../layouts/base.astro'
import Balance from '../components/balance.astro'
import Glyph from '../components/glyph.astro'
import Icon from '../components/icon.astro'
import Money from '../components/money.astro'
import Plate from '../components/plate.astro'
import Receipt from '../components/receipt.astro'
import Rosette from '../components/rosette.astro'
import Ruler from '../components/ruler.astro'
import Shield from '../components/shield.astro'
import { host } from '../lib/content'
import { SHIELD } from '../lib/docker'
import { emblem, indexGlyph, tagGlyph } from '../lib/glyphs'
import { inline, renderMarkdown } from '../lib/markdown'
import { projects, vicinity, type Project } from '../lib/projects'
import { knownOf } from '../lib/readme'
import { rosette } from '../lib/rosette'
import { LATCH, LATCH_KEY, PROSE, SITE, absoluteUrl, detent, focusRing, pageTitle } from '../lib/site'
import { fill, text } from '../lib/text'

/**
 * Página do projeto: pranchas no eixo horizontal (.analyse/design.md › Espaço). A primeira é a
 * ficha com todos os dados do repositório; depois, uma prancha por seção do README, na ordem dele;
 * por fim o código da pasta e o próximo cofre. O emblema do topo é o mesmo que foi clicado no mostrador.
 */
export function getStaticPaths() {
	return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}

interface Props {
	project: Project
}

const { project: p } = Astro.props
const t = text.project
const r = text.readout
const { next, prev } = vicinity(p)
const dash = r.none

const slugify = (s: string) =>
	s
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '')

const parts = await Promise.all(
	p.doc.parts.map(async (part) => ({ ...part, id: slugify(part.title), kind: knownOf(part.title), html: await renderMarkdown(part.body) })),
)
const LANG: Record<string, string> = { php: 'php', py: 'python', ts: 'ts', js: 'js', sh: 'sh', json: 'json', txt: 'txt', yml: 'yaml', yaml: 'yaml', toml: 'toml' }
const sources = await Promise.all(
	p.sources.map(async (f) => {
		const ext = f.path.split('.').pop() ?? ''
		const lang = LANG[ext] ?? 'txt'
		return { ...f, html: await renderMarkdown(`\`\`\`${lang}\n${f.code.trimEnd()}\n\`\`\``) }
	}),
)
const scene = p.doc.diagram ? rosette(p.doc.diagram) : null

const plates = [
	{ id: 'ficha', title: t.sheet },
	...parts.map((x) => ({ id: x.id, title: x.title })),
	...(sources.length ? [{ id: 'codigo', title: t.code }] : []),
	{ id: 'proximo', title: t.next },
]
const n = (id: string) => plates.findIndex((x) => x.id === id) + 1

const kb = (b: number) => (b < 1024 ? `${b} B` : `${(b / 1024).toFixed(1)} KB`)
const links = [
	{ label: t.folder, href: p.github.folder, text: host(p.github.folder), icon: 'tech-github' as const },
	{ label: t.repository, href: p.repo.url, text: `${p.repo.label} · ${host(p.repo.url)}`, icon: 'git-branch' as const },
	{ label: t.readme, href: p.github.readme, text: host(p.github.readme), icon: 'file-code' as const },
	{ label: t.docker, href: p.github.docker, text: host(p.github.docker), icon: 'terminal' as const },
	{ label: t.page, href: absoluteUrl(p.href), text: host(absoluteUrl(p.href)), icon: 'globe' as const },
]
const facts = [
	{ label: t.path, value: p.path },
	{ label: t.segment, value: p.repo.segment || dash },
	{ label: t.status, value: p.wip ? t.wip : t.stable },
	{ label: text.home.measured, value: p.repo.measured || dash },
	{ label: text.home.spec, value: p.repo.spec || dash },
	{ label: r.opening, value: p.balance.initial || dash },
	{ label: r.concurrent, value: p.concurrency ?? dash },
	{ label: r.responses, value: p.responses.length },
	{ label: r.cpus, value: p.docker.cpus || dash },
	{ label: r.memory, value: p.docker.memory || dash },
	{ label: r.port, value: p.docker.port || dash },
	{ label: r.pids, value: p.docker.pids || dash },
	{ label: r.stop, value: p.docker.stopTimeout ? `${p.docker.stopTimeout}s` : dash },
	{ label: r.image, value: p.docker.image || dash },
	{ label: r.files, value: p.sources.length || dash },
	{ label: r.lines, value: p.lines || dash },
	{ label: r.steps, value: p.doc.steps.length },
]
const chip = `inline-flex min-h-8 items-center gap-1.5 rounded-full border border-line px-2.5 text-[11px] text-fg-muted ${detent}`

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareSourceCode',
		name: p.name,
		description: p.description,
		url: absoluteUrl(p.href),
		codeRepository: p.github.folder,
		programmingLanguage: p.technologies,
		keywords: p.tags.join(', '),
		creativeWorkStatus: p.wip ? t.wip : t.stable,
		author: { '@type': 'Person', name: SITE.author, url: SITE.home },
	},
]
---

<Base title={pageTitle(p.name)} description={p.description} path={p.href} image={`/${p.slug}/og.png`} jsonLd={jsonLd}>
	<Ruler slot="bar" plates={plates} />

	<div data-plates class="flex h-full snap-x snap-mandatory overflow-x-auto overflow-y-hidden overscroll-x-contain [scrollbar-width:none]">
		<!-- ficha -->
		<Plate id="ficha" n={1} title={t.sheet} wide>
			<div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-12">
				<div class="flex flex-col gap-5">
					<Glyph shapes={emblem(p.tags, 64)} size={64} class="size-48 self-center lg:size-72 lg:self-start" label={p.tags.map((x) => `#${x}`).join(' ')} live draw vault />
					<div>
						<p class="eyebrow tabular-nums">{p.serial} / {String(projects.length).padStart(2, '0')}</p>
						{p.wip && <p class="mt-3 inline-flex items-center gap-2 rounded-full border border-brand/40 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-brand"><span class="size-1.5 rounded-full bg-brand animate-pulse-dot motion-reduce:animate-none" />{t.wip}</p>}
						<h1 class="mt-3 text-3xl leading-tight font-normal tracking-tight text-fg lg:text-4xl">{p.title}</h1>
						{p.subtitle && <p class="mt-2 text-sm text-fg-muted">{p.subtitle}</p>}
					</div>
					<p class="text-xs leading-relaxed text-fg-muted">{p.description}</p>
					{p.doc.intro && <p class="border-l border-brand/40 pl-3 text-xs leading-relaxed text-fg-subtle [&_code]:text-fg" set:html={inline(p.doc.intro)} />}
				</div>

				<div class="flex min-w-0 flex-col gap-6">
					<div class="flex flex-wrap items-center gap-6 rounded-card border border-line bg-surface-1 p-5">
						<div>
							<p class="eyebrow">{p.balance.final ? r.balance : r.responses}</p>
							{p.balance.final ? <Money value={p.balance.final} class="mt-2 text-5xl" /> : <p class="kpi-xl mt-2">{p.responses.length}</p>}
						</div>
						<dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
							<dt class="text-fg-subtle">{r.ok}</dt>
							<dd class="tabular-nums text-brand">{p.ok}</dd>
							<dt class="text-fg-subtle">{r.refused}</dt>
							<dd class="tabular-nums text-fg">{p.refused}</dd>
						</dl>
						<div class="flex items-center gap-3 sm:ml-auto">
							<Shield docker={p.docker} class="size-12" />
							<div>
								<p class="text-[10px] uppercase tracking-wider text-fg-subtle">{r.armor}</p>
								<p class="text-sm tabular-nums text-fg">{p.armor}/{SHIELD.length}</p>
							</div>
						</div>
					</div>

					<ul class="grid gap-1.5 text-[11px] sm:grid-cols-2">
						{
							SHIELD.map((k) => (
								<li class:list={['flex items-center gap-2', p.docker.shield[k] ? 'text-fg-muted' : 'text-fg-faint line-through']}>
									<span class:list={['size-2 shrink-0 rounded-full', p.docker.shield[k] ? 'bg-brand' : 'border border-fg-faint']} />
									{text.shield[k]}
								</li>
							))
						}
					</ul>

					<dl class="flex flex-wrap gap-px overflow-hidden rounded-card border border-line bg-line">
						{
							facts.map((x) => (
								<div class="flex min-w-[9rem] flex-1 flex-col gap-1 bg-surface-0 p-3">
									<dt class="text-[10px] uppercase tracking-wider text-fg-subtle">{x.label}</dt>
									<dd class="text-[13px] break-words tabular-nums text-fg">{x.value}</dd>
								</div>
							))
						}
					</dl>

					<ul class="grid gap-1">
						{
							links.map((l) => (
								<li>
									<a href={l.href} target="_blank" rel="noopener" class={`group flex min-h-11 items-center gap-3 rounded-control px-2 hover:bg-white/[0.03] ${detent} ${focusRing}`}>
										<Icon name={l.icon} class="size-4 text-fg-subtle group-hover:text-brand" />
										<span class="w-24 shrink-0 text-[10px] uppercase tracking-wider text-fg-subtle">{l.label}</span>
										<span class="min-w-0 truncate text-xs text-fg-muted group-hover:text-fg">{l.text}</span>
									</a>
								</li>
							))
						}
					</ul>

					<div class="grid gap-5 sm:grid-cols-2">
						<div>
							<p class="eyebrow mb-2">{r.technologies}</p>
							<ul class="flex flex-wrap gap-1.5">{p.technologies.map((x) => <li class={chip}>{x}</li>)}</ul>
						</div>
						<div>
							<p class="eyebrow mb-2">{r.tags}</p>
							<ul class="flex flex-wrap gap-1.5">
								{
									p.tags.map((x) => (
										<li>
											<a href={`/?tag=${encodeURIComponent(x)}`} class={`${chip} pl-1 hover:border-line-strong hover:text-fg ${focusRing}`}>
												<Glyph shapes={tagGlyph(x, 24)} size={24} class="size-5" />#{x}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</Plate>

		<!-- uma prancha por seção do README -->
		{
			parts.map((part) => (
				<Plate id={part.id} n={n(part.id)} title={part.title}>
					{part.kind === 'Diagrama' && scene ? (
						<Rosette scene={scene} source={p.doc.diagram} />
					) : part.kind === 'Cenário' ? (
						<div class="flex flex-col gap-6">
							<Receipt project={p} />
							<p class="text-sm leading-relaxed text-fg-muted [&_code]:text-fg" set:html={inline(p.doc.scenario)} />
							{p.doc.output && (
								<p class="rounded-card border border-line bg-surface-sunken p-3 text-xs leading-relaxed text-fg-muted [&_code]:text-brand">
									<span class="eyebrow mr-2">{t.output}</span>
									<span set:html={inline(p.doc.output)} />
								</p>
							)}
							<button type="button" class={`${LATCH_KEY} self-start`} data-fire data-label={t.fire} data-busy={t.firing}>
								{t.fire}
							</button>
						</div>
					) : part.kind === 'Como funciona' && p.doc.steps.length ? (
						<ol class="grid gap-4">
							{p.doc.steps.map((step, i) => (
								<li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3">
									<span class="flex flex-col items-center gap-1">
										<Glyph shapes={indexGlyph(i + 1, p.doc.steps.length, 24)} size={24} class="size-8" live />
										<span class="text-[10px] tabular-nums text-fg-faint">{String(i + 1).padStart(2, '0')}</span>
									</span>
									<p class="pt-1.5 text-xs leading-relaxed text-fg-muted [&_code]:rounded-badge [&_code]:bg-surface-3 [&_code]:px-1 [&_code]:text-fg" set:html={inline(step)} />
								</li>
							))}
						</ol>
					) : part.kind === 'Skills' && p.doc.skills.rows.length ? (
						<ul class="grid gap-3">
							{p.doc.skills.rows.map((row) => (
								<li class="rounded-card border border-line bg-surface-1 p-4">
									<p class="eyebrow mb-2">
										{p.doc.skills.head[0]} · <span class="text-fg">{row[0]}</span>
									</p>
									<p class="text-xs leading-relaxed text-fg-muted [&_a]:text-brand [&_a]:underline [&_a]:underline-offset-4 [&_code]:text-fg" set:html={inline(row[1] ?? '')} />
								</li>
							))}
						</ul>
					) : part.kind === 'Trade-offs' && p.doc.tradeoffs.rows.length ? (
						<Balance table={p.doc.tradeoffs} />
					) : (
						<div class:list={[PROSE, part.kind === 'Executar' && '[&_pre]:text-[11px]']} set:html={part.html} />
					)}
				</Plate>
			))
		}

		<!-- código da pasta -->
		{
			sources.length > 0 && (
				<Plate id="codigo" n={n('codigo')} title={t.code}>
					<p class="text-[11px] tabular-nums text-fg-subtle">{fill(t.files, { n: sources.length, lines: p.lines, bytes: kb(p.bytes) })}</p>
					<ul class="grid gap-2">
						{sources.map((f) => (
							<li>
								<details class="group rounded-card border border-line bg-surface-1 open:bg-surface-sunken">
									<summary class={`flex cursor-pointer list-none items-center gap-3 rounded-card px-3 py-2.5 text-xs hover:text-fg ${focusRing}`}>
										<span class="size-2 shrink-0 rounded-full border border-brand group-open:bg-brand" />
										<span class="min-w-0 flex-1 truncate text-fg-muted group-open:text-fg">{f.path}</span>
										<span class="shrink-0 text-[11px] tabular-nums text-fg-faint">{f.lines} · {kb(f.bytes)}</span>
									</summary>
									<div class:list={[PROSE, 'border-t border-line px-3 pb-3 [&_pre]:border-0 [&_pre]:bg-transparent [&_pre]:p-0 [&_pre]:text-[11px]']} set:html={f.html} />
								</details>
							</li>
						))}
					</ul>
				</Plate>
			)
		}

		<!-- próximo cofre -->
		<Plate id="proximo" n={n('proximo')} title={t.next}>
			<a href={next.href} class={`group flex flex-col items-start gap-5 rounded-panel border border-line bg-surface-1 p-6 hover:border-brand/40 ${detent} ${focusRing}`} data-next>
				<Glyph shapes={emblem(next.tags, 64)} size={64} class="size-40" />
				<span class="eyebrow tabular-nums">{next.serial} / {String(projects.length).padStart(2, '0')}</span>
				<span class="text-2xl leading-tight text-fg group-hover:text-brand">{next.title}</span>
				<span class="text-xs text-fg-muted">{next.subtitle}</span>
				<span class={LATCH_KEY}>{t.next} <Icon name="arrow-right" class="size-3.5" /></span>
			</a>
			<div class="flex flex-wrap gap-3">
				<a href={prev.href} class={LATCH}><Icon name="arrow-left" class="size-3.5" /> {prev.serial} {prev.short}</a>
				<a href="/" class={LATCH}>{t.back}</a>
			</div>
		</Plate>
	</div>
</Base>

<script>
	import '../scripts/plates'
</script>
